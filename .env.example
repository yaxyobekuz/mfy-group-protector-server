# ── BAZA ──────────────────────────────────────────────────────────────
# Bitta toza PostgreSQL bazasi. study-tracker'dagi `?schema=` bilan
# filial tanlash naqshi BU YERDA YO'Q — viloyat shtabi bitta tashkilot.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viloyat_shtabi?schema=public"

# ── SERVER ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Admin panel manzili — CORS uchun. Vergul bilan bir nechta berish mumkin.
CORS_ORIGINS="http://localhost:3000"

# ── YUKLANGAN FAYLLAR (murojaat dalillari) ────────────────────────────
# ⚠️ ISHLAB CHIQARISHDA MAJBURIY QO'YILADI va qiymat KOD KATALOGIDAN
# TASHQARIDA bo'lishi shart.
#
# Bo'sh qoldirilsa fayllar `<loyiha>/uploads/appeals/` ga yoziladi —
# ya'ni KOD BILAN BITTA JOYGA. Deploy o'sha joyni almashtiradi:
# konteyner qayta qurilsa yoki kod yangi katalogga clone qilinsa,
# fayllar KOD BILAN BIRGA KETADI. Bazada faqat yo'l saqlanadi
# (`IssueAttachment`), ya'ni panelda murojaat ko'rinib turadi, surati
# esa ochilmaydi — "Fayl — dalil, bezak emas" qoidasi buziladi.
#
#   VPS / PM2 → UPLOADS_DIR="/var/lib/viloyat-shtabi/uploads"
#   Docker    → UPLOADS_DIR="/data/uploads" + o'sha yo'lga VOLUME ulanadi
#
# ⚠️ YO'LNI KEYIN O'ZGARTIRSANGIZ eski fayllarni YANGI joyga ko'chiring:
# bazadagi yozuvlar qoladi, bayt esa eski papkada qolib ketadi.
UPLOADS_DIR=""

# ── JWT ───────────────────────────────────────────────────────────────
# ⚠️ IKKI ALOHIDA SIR. Bitta sir ishlatilsa, access token refresh
# sifatida ham qabul qilinardi (`typ` tekshiruvi aylanib o'tilsa) —
# ikkita sir buni STRUKTURAVIY imkonsiz qiladi.
JWT_ACCESS_SECRET="almashtiring-access-sirini-kamida-32-belgi"
JWT_REFRESH_SECRET="almashtiring-refresh-sirini-kamida-32-belgi"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── AI TAHLILI (O'ZIMIZNING SHLYUZ) ───────────────────────────────────
# ⚠️ ENDI OpenAI EMAS: model o'zimizning serverda (`api.vircity.uz`)
# ishlaydi va chaqiruv BEPUL. Shuning uchun o'zgaruvchi nomi ham
# `OPENAI_API_KEY` EMAS — eskicha nom keyingi o'qigan odamni
# `platform.openai.com` dan kalit izlashga yuborardi.
#
# ⚠️ Kalit bo'lmasa tizim ISHLAYDI: guruh xabarlari to'planadi, lekin
# tahlil qilinmaydi (mobil taklif ham chiqmaydi). Bu fon ishi va uning
# yo'qligi hech narsani to'xtatmaydi.
#
# Kalitni MA'MURDAN olinadi — har ilovaga bitta. Faqat SERVERDA
# turadi: frontend'ga, mobil ilovaga yoki git'ga TUSHMAYDI.
AI_API_KEY=""

# Shlyuz manzili. Bo'sh qoldirilsa standart qiymat ishlatiladi —
# `https://api.vircity.uz/v1`.
#
# ⚠️ `/v1` QO'SHIMCHASI SHART: SDK unga `/chat/completions` ni qo'shib
# yozadi. Usiz so'rov 404 bo'lardi.
#
# ⚠️ MODEL NOMI BU YERDA EMAS, KODDA
# (`signals/ai/signal-ai.constants.ts`): manzil — infratuzilma
# (domen ko'chishi mumkin), model esa SIFAT masalasi va review'dan
# o'tishi kerak.
AI_BASE_URL=""

# ⚠️ EMBEDDING YO'Q: shlyuzda `/embeddings` endpoint'i mavjud emas
# (404). Ya'ni semantik qidiruv, dublikat aniqlash va RAG bu shlyuz
# ustida QURILMAYDI — kerak bo'lsa avval ma'murdan embedding modelini
# yoqishni so'rash kerak (`AI-SERVER-CHEATSHEET.md`, §9).

# ── BOT BILAN ALOQA ───────────────────────────────────────────────────
# ⚠️ Bot serverga SHU KALIT bilan murojaat qiladi (`X-Bot-Key`). Botda
# JWT yo'q: u foydalanuvchi emas, ishonchli XIZMAT. Ikki tomonda AYNI
# qiymat bo'lishi shart.
BOT_API_KEY="almashtiring-bot-kalitini"

# Serverdan botga xabar yuborish uchun (muammo javobi). Bo'sh bo'lsa
# javob yuborilmaydi — tizim baribir ishlaydi. Mini App'da `initData`
# imzosini tekshirish ham SHU token bilan.
BOT_TOKEN=""

# ── MINI APP (FUQARO MUROJAATLARI) ────────────────────────────────────
# ⚠️ UCHINCHI ALOHIDA SIR (JWT access/refresh dan ham, bir-biridan ham
# alohida). Fuqaro tokeni shu bilan imzolanadi — `typ` tekshiruvi tushib
# qolsa ham fuqaro tokeni panelga KIRA OLMAYDI. Imzolangan havolalar
# (upload token, AI taklifi) ham shundan HMAC kaliti oladi.
MOBILE_JWT_SECRET="almashtiring-mobil-sirini-kamida-32-belgi"
MOBILE_JWT_TTL="30d"
# Mini App manzili — bot menyu tugmasi (`setChatMenuButton`) va CORS
# uchun. Ishlab chiqishda `node tools/mini-app-tunnel.mjs` yozadi.
MOBILE_APP_URL=""

# ── BIRINCHI XODIM (seed) ─────────────────────────────────────────────
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="owner123"

# ── MOBIL ILOVA (Flutter) — GOOGLE BILAN KIRISH ───────────────────────
# ⚠️ WEB TURIDAGI OAuth mijoz id'si — Android/iOS niki EMAS.
# `google_sign_in` ga `serverClientId` sifatida aynan shu beriladi va
# `id_token.aud` ham shunga teng bo'ladi. Android id yozilsa, imzo
# to'g'ri bo'lsa ham kirish "yaroqsiz token" bilan rad etilardi.
#
# ⚠️ Bo'sh bo'lsa Google kirishi O'CHADI (endpoint 503 beradi), lekin
# mini-ilova (Telegram) ishlayveradi — ikki yo'l bir-biriga bog'liq emas.
GOOGLE_CLIENT_ID=""

# iOS uchun ALOHIDA: u yerda `google_sign_in` `aud` ni O'ZINING mijoz
# id'siga qo'yadi va yagona `aud` tekshiruvi iPhone'dan kirishni
# butunlay bloklardi.
GOOGLE_IOS_CLIENT_ID=""

# ── "SIGN IN WITH APPLE" (iOS) ─────────────────────────────────────────
# ⚠️ QIYMAT — iOS BUNDLE ID (`uz.mysrv.nazoratchi`), Apple Developer'dagi
# "Services ID" EMAS: `sign_in_with_apple` ilova ichidan kirganda Apple
# `id_token.aud` ni ilovaning bundle id'siga qo'yadi. (Services ID faqat
# veb-oqimda ishlatiladi — bizda u yo'q.)
#
# ⚠️ Bo'sh bo'lsa Apple kirishi O'CHADI (endpoint 503 beradi), Google va
# mini-ilova ishlayveradi — kirish yo'llari bir-biriga bog'liq emas.
APPLE_CLIENT_ID="uz.mysrv.nazoratchi"

# ── APPLE RUXSATINI BEKOR QILISH (hisob o'chirilganda) ─────────────────
# ⚠️ NIMA UCHUN KERAK: App Store qoidasi 5.1.1(v) — Apple bilan kirgan
# fuqaro hisobini o'chirganda Apple TOMONIDAGI ruxsat ham bekor
# qilinishi SHART (`/auth/revoke`). Faqat bazani tozalash YETARLI EMAS:
# iPhone sozlamalarida ilova "Apple ID bilan bog'langan" bo'lib turardi
# va App Store tekshiruvi aynan shuni ushlaydi.
#
# ⚠️ UCHALASI BO'SH BO'LSA revoke O'TKAZIB YUBORILADI va hisob BARIBIR
# o'chadi (Google bilan ayni mantiq). O'chirishni revoke'ga bog'lash
# fuqaroni "hisobimni o'chirib bo'lmayapti" holatida qoldirardi — bu
# do'kon talabini BUZISH bo'lardi. Sabab logga yoziladi.
#
# Apple Developer → Membership → Team ID (10 belgi).
APPLE_TEAM_ID=""
# Apple Developer → Keys → "Sign in with Apple" kaliti id'si (10 belgi).
APPLE_KEY_ID=""
# ⚠️ IKKI SHAKLDAN BIRI (`APPLE_PRIVATE_KEY` ustun turadi):
#
#   1. KALITNING O'ZI — `.p8` faylining PEM matni. `.env` da haqiqiy
#      yangi qator yozib bo'lmaydi, shuning uchun `\n` belgilar bilan
#      BIR QATORDA yoziladi (server ularni o'zi qator ajratgichga
#      aylantiradi):
#      APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n"
#
#   2. FAYLGA YO'L — ko'p qatorli PEM bilan ishlash qulayroq. Fayl
#      KOD KATALOGIDAN TASHQARIDA turishi kerak (`UPLOADS_DIR` bilan
#      ayni sabab) va `git` ga TUSHMASLIGI shart — bu TIRIK kalit.
#      APPLE_PRIVATE_KEY_PATH="/var/lib/viloyat-shtabi/AuthKey_XXXXXXXXXX.p8"
APPLE_PRIVATE_KEY=""
APPLE_PRIVATE_KEY_PATH=""

# ── API HUJJATI (Swagger) ──────────────────────────────────────────────
# ⚠️ ISHLAB CHIQISHDA SHARTSIZ OCHIQ (`/api/docs`), `production` DA
# STANDART HOLDA YOPIQ. Teskarisi ("kerak bo'lsa yopamiz") amalda ochiq
# qolib ketishi bilan tugaydi — va buni hech kim sezmaydi, chunki
# hujjat ishlab turganda hech narsa buzilmaydi. Hujjat esa butun API
# tuzilmasini, DTO maydonlarini va ruxsat nomlarini oshkor qiladi.
#
# ⚠️ `production` DA OCHISH UCHUN IKKI SHART: `true` VA PAROL. Parol
# bo'lmasa hujjat ULANMAYDI va sabab logga chiqadi — "yoqdim, lekin
# parolni unutdim" holati ochiq hujjat bo'lib qolardi.
SWAGGER_ENABLED="false"
SWAGGER_USER=""
SWAGGER_PASSWORD=""
