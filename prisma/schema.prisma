// ╔══════════════════════════════════════════════════════════════════════╗
// ║  VILOYAT SHTABI — MFY guruhlaridagi muammolarni aniqlash tizimi      ║
// ╚══════════════════════════════════════════════════════════════════════╝
//
// Tizimning mohiyati bir gapda: viloyatdagi MAHALLA (MFY) Telegram
// guruhlarida aholi nima deb yozyapti — shundan ma'muriyat ko'rishi kerak
// bo'lgan MUAMMOLARNI ajratib olish.
//
// ── OQIM ──────────────────────────────────────────────────────────────
//
//   MFY guruhi            bot KUZATUVCHI sifatida o'qiydi
//        ↓                (hech narsa yozmaydi, javob bermaydi)
//   group_messages        NAVBAT — tahlilsiz xom xabar
//        ↓                AI (cron, har 30 daqiqada)
//   group_signals         AI TAXMINI — "bu gap muammoga o'xshaydi"
//        ↓                ODAM qarori (panelda kategoriya tanlaydi)
//   issues                RASMIY MUROJAAT navbati
//        ↓
//   javob → botga qaytadi (muallif qo'lda yuborgan bo'lsa)
//
// ── ASOSIY DOKTRINALAR ────────────────────────────────────────────────
//
// ⚠️ 1. SIGNAL — MUAMMO EMAS. Bu butun tizimning eng muhim qarori.
//    Xulosani AI chiqargan, ya'ni u xato bo'lishi mumkin: hazilni
//    shikoyat deb, shikoyatni hazil deb topishi mumkin. `issues` esa
//    ma'muriyat ISHONADIGAN rasmiy navbat — unga tekshirilmagan taxminni
//    qo'yish o'sha ishonchni buzardi. Shuning uchun `GroupSignal` va
//    `Issue` — IKKI ALOHIDA jadval va o'tish faqat ODAM qarori bilan
//    bo'ladi (`signals.service.ts#attach`).
//
// ⚠️ 2. GURUH → MFY → TUMAN. Hududiy kesim guruhga SOZLAMALARDA
//    biriktiriladi, Telegram'dan kelmaydi: guruh nomida "Chilonzor
//    12-MFY" deb yozilgan bo'lishi mumkin, lekin unga ishonib hisobot
//    qurish mumkin emas (nom o'zgaradi, xato yoziladi, umuman
//    yozilmaydi). Shuning uchun `mahallaId` QO'LDA qo'yiladi va u NULL
//    bo'lishi mumkin — "hali biriktirilmagan".
//
// ⚠️ 3. HUDUDIY KO'RINISH — XODIM DARAJASIDA. Viloyat shtabi xodimi
//    hammasini ko'radi, tuman xodimi faqat o'z tumanini. Bu
//    `User.scopeKind` + `User.districtId` bilan hal qilinadi va
//    HAR SO'ROVDA server tomonida qo'llanadi (`scope.util.ts`) —
//    frontendda emas.
//
// ⚠️ 4. BAZA BITTA VA TOZA. study-tracker'dagi multi-tenant (platform +
//    br_<kod> schema'lari, AsyncLocalStorage Proxy) bu yerda YO'Q va
//    kerak ham emas: viloyat shtabi — BITTA tashkilot. Hududiy ajratish
//    ma'lumot darajasida (FK), ulanish darajasida emas.
//
// ── SANA VA VAQT ──────────────────────────────────────────────────────
//
// ⚠️ Butun tizim Asia/Tashkent (+5, DST yo'q). Barcha `DateTime` —
//    haqiqiy INSTANT (UTC'da saqlanadi, Toshkent devor-soatida
//    ko'rsatiladi). "UTC yarim tunidagi KUN" naqshi bu yerda YO'Q:
//    kun aniqligidagi maydon umuman ishlatilmaydi, shuning uchun
//    "sana bir kunga siljidi" klassik xatosi tug'ilmaydi ham.

generator client {
  provider = "prisma-client-js"

  // ⚠️ `output` BERILMAYDI — client `node_modules/.prisma/client` ga
  // chiqadi va `@prisma/client` orqali import qilinadi.
  //
  // `../src/generated/prisma` ga chiqarish vasvasasi bor (turlar
  // ko'rinib turadi), lekin u ISHLAB CHIQARISHDA SINDIRADI:
  // `tsconfig.build.json` `src/generated` ni chiqarib tashlaydi
  // (u generatsiya qilingan kod, versiyalanmaydi), natijada
  // `dist/` ichida client YO'Q bo'lib qoladi va server
  // `MODULE_NOT_FOUND` bilan yiqiladi. Build esa muvaffaqiyatli
  // o'tadi — xato faqat ishga tushirishda chiqadi.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════
//  HUDUD — tuman → MFY
// ══════════════════════════════════════════════════════════════════════

/// TUMAN (yoki shahar) — hududiy birlikning yuqori darajasi.
///
/// ⚠️ VILOYAT JADVALI YO'Q va bu ataylab: tizim BITTA viloyat uchun
/// ishlaydi (nomi `Settings.orgName` da). Viloyatlar jadvali qo'shilsa,
/// u darhol bo'sh ierarxiya qatlamiga aylanardi — har so'rovda `where`
/// ga qo'shiladigan, lekin hech qachon birdan ortiq qatori bo'lmaydigan
/// jadval.
model District {
  id String @id @default(cuid())

  /// Qisqa kod — URL va import uchun ("chilonzor").
  code String @unique
  name String

  /// Ro'yxatdagi tartib — alifbo emas, ma'muriy tartib ko'pincha boshqa.
  sortOrder Int @default(0) @map("sort_order")

  /// ⚠️ O'CHIRILMAYDI, ARXIVLANADI: tumanga biriktirilgan MFY, guruh,
  /// signal va muammolar tarixi qoladi.
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mahallas      Mahalla[]
  users         User[]
  citizens      Citizen[]
  announcements Announcement[]

  @@index([isArchived, sortOrder])
  @@map("districts")
}

/// MAHALLA (MFY) — hududiy birlikning quyi darajasi va tizimning asosiy
/// kuzatuv obyekti.
///
/// ⚠️ BITTA MFY — BIR NECHTA GURUH bo'lishi mumkin (aholi guruhi,
/// e'lonlar kanali, yoshlar guruhi). Shuning uchun bog'lanish
/// `TelegramGroup.mahallaId` da, bu yerda emas.
model Mahalla {
  id String @id @default(cuid())

  districtId String @map("district_id")

  code String @unique
  name String

  /// Raisning ismi va telefoni — muammo bo'yicha kim bilan gaplashish
  /// kerakligi panelda darhol ko'rinishi uchun.
  chairmanName  String? @map("chairman_name")
  chairmanPhone String? @map("chairman_phone")

  /// Aholi soni — hisobotda "1000 aholiga nechta murojaat" kesimi uchun.
  /// Majburiy emas: ko'pincha noma'lum va uni majburlash ma'lumot
  /// kiritishni butunlay to'xtatib qo'yardi.
  population Int?

  sortOrder Int @default(0) @map("sort_order")

  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  groups   TelegramGroup[]
  issues   Issue[]
  citizens Citizen[]

  @@index([districtId, isArchived, sortOrder])
  @@map("mahallas")
}

// ══════════════════════════════════════════════════════════════════════
//  XODIMLAR VA RUXSAT
// ══════════════════════════════════════════════════════════════════════

/// Xodimning HUDUDIY ko'rinish darajasi.
///
/// ⚠️ BU RUXSAT EMAS, QAMROV. Ruxsat "nima qila oladi" (`permissions`),
/// qamrov esa "kimning ma'lumotini ko'radi". Ikkisi ALOHIDA: tuman
/// xodimi ham signalni muammoga biriktira oladi, lekin faqat o'z
/// tumanidagi guruhdan chiqqanini.
enum ScopeKind {
  /// Butun viloyat — barcha tumanlar.
  province
  /// Faqat `User.districtId` dagi tuman.
  district
}

enum UserRole {
  /// Tizim egasi — hamma narsa, ruxsat tekshirilmaydi.
  owner
  /// Shtab ma'muriyati.
  admin
  /// Operator — signal ko'radi, muammo yuritadi.
  operator
  /// Faqat o'qiydi (hisobot uchun).
  viewer
}

model User {
  id String @id @default(cuid())

  /// ⚠️ Login butun tizim bo'ylab YAGONA. Bu study-tracker'dagi
  /// `platform.user_directory` ning soddalashtirilgan ko'rinishi: baza
  /// bitta bo'lgani uchun alohida reyestr kerak emas, `@unique` yetarli.
  username     String @unique
  /// ⚠️ ARGON2ID HASH. Bcrypt emas: argon2id — hozirgi tavsiya (OWASP)
  /// va bcrypt'ning 72-bayt kesilishi muammosi yo'q.
  passwordHash String @map("password_hash")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  role UserRole @default(operator)

  /// ── QAMROV ──────────────────────────────────────────────────────
  ///
  /// ⚠️ `district` bo'lsa `districtId` MAJBURIY. Bazada buni ifodalash
  /// mumkin emas (shartli NOT NULL), shuning uchun tekshiruv service'da
  /// (`users.service.ts`). Qo'yilmasa xodim HECH NARSA ko'rmaydi —
  /// ochib qo'yishdan ko'ra xavfsizroq.
  scopeKind  ScopeKind @default(district) @map("scope_kind")
  districtId String?   @map("district_id")

  /// Ruxsatlar — `common/permissions.ts` dagi katalogdan olingan
  /// satrlar ("groups.manage", "signals.attach", ...).
  ///
  /// ⚠️ MASSIV, ALOHIDA JADVAL EMAS. Ruxsatlar soni o'nlab va ular
  /// FAQAT shu xodim bilan birga o'qiladi — join qiladigan narsa yo'q.
  /// `owner` uchun bu massiv umuman o'qilmaydi.
  permissions String[] @default([])

  isActive   Boolean   @default(true) @map("is_active")
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  /// Telegram bog'lanishi — xodim botdan muammo yuborishi uchun.
  ///
  /// ⚠️ BITTA TELEGRAM — BITTA XODIM (`@unique`). Aks holda bir
  /// telegramdan kelgan muammo kim nomidan yozilganini aniqlash
  /// mumkin bo'lmasdi.
  telegramId String? @unique @map("telegram_id")

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  officialGroups   TelegramGroup[] @relation("GroupOfficialBy")
  guardedGroups    TelegramGroup[] @relation("GroupGuardBy")
  attachedSignals  GroupSignal[]   @relation("SignalAttachedBy")
  dismissedSignals GroupSignal[]   @relation("SignalDismissedBy")
  authoredIssues   Issue[]         @relation("IssueAuthor")
  assignedIssues   Issue[]         @relation("IssueAssignee")
  reviewedIssues   Issue[]         @relation("IssueReviewedBy")
  issueComments    IssueComment[]
  sessions         Session[]

  @@index([role, isArchived])
  @@index([districtId])
  @@map("users")
}

/// REFRESH TOKEN SESSIYASI.
///
/// ⚠️ TOKEN O'ZI SAQLANMAYDI — faqat SHA-256 hash'i. Baza o'qib
/// ketilsa, o'g'irlangan hash bilan kirish mumkin emas.
///
/// ⚠️ ROTATSIYA: har yangilanishda eski qator `revokedAt` oladi va
/// YANGISI yoziladi. Bir refresh token IKKI MARTA ishlatilsa — bu
/// o'g'irlanish belgisi va o'sha xodimning BARCHA sessiyalari yopiladi
/// (`auth.service.ts#refresh`).
model Session {
  id String @id @default(cuid())

  userId String @map("user_id")

  tokenHash String @unique @map("token_hash")

  userAgent String? @map("user_agent")
  ip        String?

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ══════════════════════════════════════════════════════════════════════
//  TELEGRAM GURUHLARI
// ══════════════════════════════════════════════════════════════════════

/// BOT KO'RGAN GURUH/KANAL — reyestr.
///
/// ── NIMA UCHUN REYESTR KERAK ──────────────────────────────────────
///
/// ⚠️ Telegram Bot API'da "men qaysi guruhlarda a'zoman" degan savolga
/// javob beradigan metod YO'Q. `getChats` faqat MTProto'da, ya'ni bot
/// emas, ODAM nomidan ulanishda mavjud. Bot faqat O'ZIGA kelgan
/// hodisadan biladi, shuning uchun ro'yxatni biz to'playmiz:
///
///   my_chat_member   → botning holati o'zgardi (asosiy manba)
///   guruhdagi xabar  → zaxira (hodisa o'tkazib yuborilgan bo'lsa)
///
/// ⚠️ O'TMISHGA QARAMAYDI: bot bu kod joylashtirilishidan OLDIN a'zo
/// bo'lgan guruh ro'yxatga O'ZI tushmaydi — Telegram o'tgan
/// hodisalarni qayta yubormaydi. Bunday guruh unda biror harakat
/// bo'lgandan keyin tushadi (huquq o'zgarishi yoki oddiy xabar), shu
/// sababli zaxira yo'l bor.
model TelegramGroup {
  /// ⚠️ `chatId` — PK va TABIIY kalit: Telegram beradi, biz generatsiya
  /// qilmaymiz. `String`, `BigInt` emas — Telegram chat id'lari katta
  /// manfiy sonlar va ular bilan arifmetika qilinmaydi.
  chatId String @id @map("chat_id")

  /// group | supergroup | channel. `private` BU YERGA TUSHMAYDI —
  /// shaxsiy chat bu bog'lanish, guruh emas.
  type  String @default("group")
  title String

  /// Ommaviy guruhda bor, yopiqda yo'q. Xabar havolasining SHAKLI
  /// shunga bog'liq (`signals.service.ts#buildMessageLink`).
  username String?

  /// Telegram `ChatMember.status` — bot hali ichidami.
  status String @default("member")

  canPostMessages Boolean @default(false) @map("can_post_messages")
  canInviteUsers  Boolean @default(false) @map("can_invite_users")

  /// ── KUZATUVGA ROZILIK ───────────────────────────────────────────
  ///
  /// ⚠️ `isOfficial` — PANELDA qo'yiladigan belgi va bot unga HECH
  /// QACHON tegmaydi. Ma'nosi: "bu guruh yozishmasini o'qishga
  /// ruxsat". Reyestrda bot tasodifan qo'shilgan, test va umuman
  /// begona guruhlar ham bor — ularning yozishmasini o'qish mumkin
  /// emas. Belgi bo'lmasa xabar NAVBATGA HAM TUSHMAYDI
  /// (`group-watch.service.ts`).
  isOfficial Boolean   @default(false) @map("is_official")
  officialAt DateTime? @map("official_at")
  officialBy String?   @map("official_by")

  /// ── HUDUDIY BIRIKTIRISH ─────────────────────────────────────────
  ///
  /// ⚠️ TELEGRAM'DAN KELMAYDI, QO'LDA QO'YILADI (schema boshidagi
  /// 2-doktrina). `null` = "hali biriktirilmagan" va bu NORMAL holat:
  /// bot yangi guruhga qo'shilganda shunday bo'ladi. Panelda bunday
  /// guruhlar alohida ajratib ko'rsatiladi.
  mahallaId String? @map("mahalla_id")

  addedByTgId String? @map("added_by_tg_id")

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// ── XAVFSIZLIK QALQONI ──────────────────────────────────────────
  ///
  /// ⚠️ `isOfficial` DAN ALOHIDA va bu ATAYLAB. `isOfficial` —
  /// yozishmani O'QISHGA rozilik; qalqon esa aholini himoya qiladi
  /// va "o'qimayman" degan guruhda ham kerak bo'lishi mumkin.
  /// Ikkisini bitta belgiga bog'lash "kuzatuvni yoqmagunimcha
  /// viruslardan himoya ham yo'q" degan noto'g'ri bog'liqlik
  /// yaratardi.
  ///
  /// ⚠️ STANDART `false`: bot guruhga qo'shilishi bilan xabar
  /// o'chira boshlashi mumkin emas. Ma'muriyat buni ATAYLAB
  /// yoqadi — o'chirish qaytarib bo'lmaydigan amal.
  guardEnabled Boolean   @default(false) @map("guard_enabled")
  guardAt      DateTime? @map("guard_at")
  guardBy      String?   @map("guard_by")

  mahalla        Mahalla?        @relation(fields: [mahallaId], references: [id], onDelete: SetNull)
  officialUser   User?           @relation("GroupOfficialBy", fields: [officialBy], references: [id], onDelete: SetNull)
  guardUser      User?           @relation("GroupGuardBy", fields: [guardBy], references: [id], onDelete: SetNull)
  messages       GroupMessage[]
  signals        GroupSignal[]
  securityEvents SecurityEvent[]

  @@index([isOfficial, status])
  @@index([mahallaId])
  @@map("telegram_groups")
}

/// RASMIY GURUHDAN KELGAN XABAR — AI tahlili uchun XOMASHYO.
///
/// ⚠️ BU NAVBAT, ARXIV EMAS. Tahlildan keyin belgilanadi va 24 soatdan
/// so'ng O'CHIRILADI (`signals.service.ts#sweep`). Sabab ikkita:
/// (1) bu aholining shaxsiy yozishmasi va uni saqlab qolish kerak emas,
/// (2) xato tekshirish uchun bir necha soat yetarli ("signal nimadan
/// chiqdi?").
///
/// ⚠️ MATN BO'LMASA YOZILMAYDI. Stiker, rasm, ovozli xabar va xizmat
/// xabarlari (kirdi/chiqdi) tahlilga hech narsa bermaydi, lekin
/// navbatni va AI hisobini shishirardi. Rasm izohi (`caption`) esa
/// matn — u olinadi.
model GroupMessage {
  id String @id @default(cuid())

  chatId    String @map("chat_id")
  /// Telegram `message_id` — havola shundan quriladi.
  messageId String @map("message_id")

  senderTgId String? @map("sender_tg_id")
  senderName String? @map("sender_name")

  text String

  /// Nimaga javob ekani. "Ha, menda ham shunday" degan xabar o'zicha
  /// ma'nosiz, javob bo'lgani bilan ma'noli — model shuni ko'radi.
  replyToText String? @map("reply_to_text")

  sentAt DateTime @map("sent_at")

  /// ⚠️ NULL = navbatda. AI yiqilsa bu ustun QO'YILMAYDI va xabar
  /// keyingi aylanishda qayta ko'riladi — aks holda u tahlilsiz qolib
  /// ketardi.
  analyzedAt DateTime? @map("analyzed_at")

  createdAt DateTime @default(now()) @map("created_at")

  group TelegramGroup @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  /// ⚠️ Bir xabar ikki marta kelishi mumkin (bot qayta ishga tushdi,
  /// Telegram takrorladi). Unique bo'lmasa navbatda dublikat paydo
  /// bo'lib, AI bir gapni ikki marta ko'rardi.
  @@unique([chatId, messageId])
  @@index([analyzedAt, sentAt])
  @@map("group_messages")
}

// ══════════════════════════════════════════════════════════════════════
//  SIGNALLAR — AI TAXMINI
// ══════════════════════════════════════════════════════════════════════

/// AI topgan toifa.
enum SignalKind {
  /// Shikoyat, norozilik, nosozlik haqida xabar.
  complaint
  /// Taklif, yaxshilash istagi.
  suggestion
  /// Javobsiz qolgan savol.
  question
}

enum SignalSeverity {
  low
  normal
  high
}

enum SignalStatus {
  /// Hali ko'rilmagan.
  new
  /// Muammoga aylantirilgan.
  attached
  /// "Bu muammo emas".
  dismissed
}

/// AI TOPGAN SIGNAL — "bu gap muammoga o'xshaydi".
///
/// ⚠️ SIGNAL — MUAMMO EMAS (schema boshidagi 1-doktrina). Bu jadval AI
/// TAXMINLARI uchun, `Issue` esa ma'muriyat ishonadigan rasmiy navbat
/// uchun.
///
/// ⚠️ MANBA XABARDAN KO'CHIRIB OLINADI, FK bilan bog'lanmaydi:
/// `group_messages` 24 soatdan keyin o'chiriladi, signal esa qoladi.
/// Shuning uchun `senderName`, `sentAt` va matn SHU YERGA muhrlanadi.
///
/// ⚠️ MATNNI AI YOZMAYDI. `summary` — XABARNING O'Z MATNI. AI faqat
/// TANLAYDI (bu gap signalga arziydimi) va TOIFALAYDI. Sabab: AI yozgan
/// xulosa har safar "...haqida shikoyat bor" degan o'ramga aylanib,
/// odamning o'z gapini uzoqlashtiradi. Odam shikoyatni o'z so'zi bilan
/// o'qiganda tezroq tushunadi.
model GroupSignal {
  id String @id @default(cuid())

  chatId    String  @map("chat_id")
  /// ⚠️ `String?`: xabar o'chirilgan bo'lsa ham signal qoladi, faqat
  /// havolasi bo'lmaydi.
  messageId String? @map("message_id")

  kind     SignalKind
  severity SignalSeverity @default(normal)
  /// Xabarning O'Z matni (kesilgan bo'lishi mumkin).
  summary  String

  /// ── MANBA (muhrlangan) ──────────────────────────────────────────
  senderTgId String?   @map("sender_tg_id")
  senderName String?   @map("sender_name")
  sentAt     DateTime? @map("sent_at")

  /// AI nechta xabarni ko'rib shu xulosaga kelgan — qamrov.
  messageCount Int @default(1) @map("message_count")

  /// Qaysi model chiqargan. Model almashganda eski signallarni ajratish
  /// uchun ("bu xulosani qaysi versiya bergan").
  model String?

  status SignalStatus @default(new)

  /// Biriktirilgan bo'lsa — qaysi muammoga.
  ///
  /// ⚠️ `@unique`: bir signal IKKI muammoga aylanmaydi. Bu
  /// `attach()` dagi holat tekshiruvining baza darajasidagi kafolati —
  /// ikki operator bir vaqtda bosgan holatda ham.
  issueId    String?   @unique @map("issue_id")
  attachedBy String?   @map("attached_by")
  attachedAt DateTime? @map("attached_at")

  /// ⚠️ E'tiborsiz qoldirilgan signal O'CHIRILMAYDI: AI nimani
  /// noto'g'ri topganini ko'rish kerak (prompt shunga qarab
  /// tuzatiladi). Ro'yxat standart holda faqat yangilarini ko'rsatadi,
  /// ya'ni bu yozuvlar ishga xalaqit bermaydi.
  dismissedBy     String?   @map("dismissed_by")
  dismissedAt     DateTime? @map("dismissed_at")
  dismissedReason String?   @map("dismissed_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group         TelegramGroup @relation(fields: [chatId], references: [chatId], onDelete: Cascade)
  issue         Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)
  attachedUser  User?         @relation("SignalAttachedBy", fields: [attachedBy], references: [id], onDelete: SetNull)
  dismissedUser User?         @relation("SignalDismissedBy", fields: [dismissedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([chatId, status])
  @@index([severity, status])
  @@map("group_signals")
}

// ══════════════════════════════════════════════════════════════════════
//  MUAMMOLAR — RASMIY NAVBAT
// ══════════════════════════════════════════════════════════════════════

/// Muammo qayerdan keldi.
///
/// ⚠️ MANBA MUHRLANADI va o'zgarmaydi. Hisobotda "AI nechta muammo
/// topdi, odam nechta yubordi" degan savolga javob shu ustundan chiqadi
/// — AI'ning foydasini o'lchashning yagona yo'li.
enum IssueSource {
  /// AI signalidan biriktirilgan.
  signal
  /// Botdan qo'lda yuborilgan.
  bot
  /// Panelda qo'lda yaratilgan.
  manual
  /// Fuqaro Mini App orqali o'zi yuborgan.
  ///
  /// ⚠️ `signal` DAN FARQI: bu yerda "bu muammomi?" degan AI taxmini
  /// YO'Q — fuqaro atayin yuborgan. Shuning uchun `group_signals`
  /// bosqichidan o'tmaydi va to'g'ridan-to'g'ri rasmiy navbatga tushadi.
  mobile
}

enum IssueStatus {
  /// Yangi — hech kim ko'rmagan.
  new
  /// Ko'rib chiqilmoqda.
  in_progress
  /// Hal qilindi.
  resolved
  /// Rad etildi (muammo emas / hududimizga tegishli emas).
  rejected
}

enum IssuePriority {
  low
  normal
  high
  urgent
}

/// MUROJAAT KATEGORIYASI — panelda sozlanadi.
///
/// ⚠️ BOT YARATMAYDI, faqat FAOL bo'lganlarini ko'rsatadi. Kategoriya
/// yo'q bo'lsa botdagi oqim BOSHLANMAYDI (`categoryId` majburiy).
model IssueCategory {
  id String @id @default(cuid())

  name  String  @unique
  /// Panelda rang bilan ajratish uchun (hex).
  color String?

  description String?

  /// ── ILOVA UCHUN QO'SHILGAN ──────────────────────────────────────
  ///
  /// ⚠️ ILOVAGA ALOHIDA TOIFA OCHILMAYDI: bu — `issue_categories` ning
  /// O'ZI. Botdan va ilovadan kelgan murojaat bir xil yo'nalishga
  /// tushadi. Ilova uchun qo'shilgani faqat ko'rinish/vaqt/tashkilot.
  ///
  /// ⚠️ `icon` — KALIT (SVG emas): `mobile/.../icons.tsx` va
  /// `admin/.../category-icons.ts` dagi kalit. Tanilmagan kalit zahira
  /// belgi beradi — toifa qo'shishni to'smaydi.
  icon String?

  /// Taxminiy javob muddati (soat) — ilovada "3 kun" deb ko'rsatiladi
  /// (`slaLabel`). Muddat MAJBURIYAT EMAS, mo'ljal (`Issue.dueAt` bilan
  /// ayni mantiq).
  slaHours Int @default(72) @map("sla_hours")

  /// Mas'ul tashkilot nomi — ilovada "Mas'ul tashkilot" qatorida.
  /// Bo'sh bo'lsa ilova `Settings.orgName` ni ko'rsatadi.
  orgName String? @map("org_name")

  sortOrder Int @default(0) @map("sort_order")

  /// ⚠️ YUMSHOQ O'CHIRISH: o'chirilgan kategoriya tugmasi botda darhol
  /// yo'qoladi, lekin ESKI MUAMMOLAR o'z kategoriyasini saqlab qoladi.
  /// Qattiq o'chirish tarixni buzardi.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issues Issue[]

  @@index([isActive, sortOrder])
  @@map("issue_categories")
}

/// RASMIY MUROJAAT — ma'muriyat ishlaydigan navbat.
model Issue {
  id String @id @default(cuid())

  /// Odam o'qiydigan raqam ("MFY-000123").
  ///
  /// ⚠️ KETMA-KET VA TESHIKSIZ BO'LISHI SHART EMAS — muhimi
  /// takrorlanmasligi. Teshiksizlikni kafolatlash har yaratishda
  /// jadvalni lock qilishni talab qilardi.
  publicNo String @unique @map("public_no")

  categoryId String @map("category_id")

  source IssueSource

  /// ⚠️ HUDUD MUAMMOGA MUHRLANADI, guruhdan JONLI o'qilmaydi. Guruhning
  /// MFY biriktirishi keyinroq o'zgarishi mumkin (xato tuzatildi, guruh
  /// boshqa mahallaga o'tdi) va o'shanda o'tgan hisobot JIMGINA qayta
  /// yozilardi: "mart oyida Chilonzorda 12 ta murojaat" degan raqam
  /// o'zgarib ketardi.
  mahallaId String? @map("mahalla_id")

  title String
  body  String

  status   IssueStatus   @default(new)
  priority IssuePriority @default(normal)

  /// ── MUALLIF ─────────────────────────────────────────────────────
  ///
  /// ⚠️ `authorId` — TIZIM XODIMI. Guruhda yozgan aholi tizimda
  /// foydalanuvchi EMAS, shuning uchun signal biriktirilganda muallif
  /// BIRIKTIRGAN ODAM bo'ladi. Haqiqiy manba yo'qolmaydi: ismi, guruh
  /// nomi va xabar havolasi `sourceMeta` da qoladi.
  authorId String? @map("author_id")

  /// ⚠️ FUQARO — XODIM EMAS. `authorId` TIZIM XODIMI (`User`), bu esa
  /// Mini App'dan yuborgan FUQARO (`Citizen`). Ikkisi ALOHIDA ustun:
  /// bir jadvalga qo'shilsa `permissions` butun aholiga tarqalardi.
  /// Mobil murojaatda `authorId` null, `citizenId` to'ladi.
  citizenId String? @map("citizen_id")

  /// Botdan kelgan bo'lsa — javob AYNAN SHU chatga qaytadi, keyin
  /// bog'lanish uzilsa ham.
  ///
  /// ⚠️ SIGNALDAN VA MOBILDAN KELGANDA ATAYLAB BO'SH: javob MFY
  /// guruhiga ketib qolmasligi kerak — bot u yerda KUZATUVCHI. Mobil
  /// javob fuqaroning SHAXSIY chatiga boradi (`citizen.telegramId`),
  /// manzil bir joyda saqlanadi.
  authorChatId String? @map("author_chat_id")

  /// ── MOBIL MUROJAAT MAYDONLARI (manba `mobile` bo'lganda) ─────────
  ///
  /// Xaritada qadalgan nuqta (ixtiyoriy — suratsiz/joysiz ham murojaat
  /// qabul qilinadi).
  lat Float?
  lng Float?
  /// Fuqaro yozgan yoki xaritadan topilgan manzil matni.
  address String?
  /// Fuqaro belgilagan bayroqlar — TAXMIN, ustuvorlikni o'zgartirmaydi,
  /// panelda faqat ko'rsatiladi (CLAUDE.md "Ustuvorlikni AI taklifi
  /// o'zgartirmaydi" bilan ayni sabab).
  isHazard       Boolean @default(false) @map("is_hazard")
  isLongStanding Boolean @default(false) @map("is_long_standing")
  isRepeatAppeal Boolean @default(false) @map("is_repeat_appeal")
  /// Muammo qachon sodir bo'lgani (fuqaro ko'rsatsa).
  occurredAt DateTime? @map("occurred_at")

  /// Manba haqida barcha ma'lumot: guruh nomi, yozgan odam, xabar
  /// havolasi, AI toifasi.
  ///
  /// ⚠️ JSON — chunki manbaga qarab maydonlar BOSHQA bo'ladi va
  /// ularning har biri uchun ustun ochish jadvalni yarmi bo'sh
  /// ustunlar bilan to'ldirardi.
  sourceMeta Json? @map("source_meta")

  /// ── IJRO ────────────────────────────────────────────────────────
  assigneeId String? @map("assignee_id")

  /// ⚠️ MUDDAT — MAJBURIYAT EMAS, MO'LJAL. Tizim uni o'tganda hech
  /// narsa qilmaydi (avtomatik eskalatsiya yo'q), faqat panelda
  /// ajratib ko'rsatadi. Avtomatik harakat qo'shilsa, u darhol
  /// "muddatni surib qo'yish" amaliyotini tug'dirardi.
  dueAt DateTime? @map("due_at")

  /// Yopilganda — kim, qachon va QANDAY hal qildi. `resolution`
  /// botdagi muallifga javob sifatida ketadi.
  resolution String?
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category    IssueCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mahalla     Mahalla?          @relation(fields: [mahallaId], references: [id], onDelete: SetNull)
  author      User?             @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  citizen     Citizen?          @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  assignee    User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer    User?             @relation("IssueReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  comments    IssueComment[]
  attachments IssueAttachment[]
  signal      GroupSignal?

  @@index([status, createdAt(sort: Desc)])
  @@index([mahallaId, status])
  @@index([categoryId, status])
  @@index([assigneeId, status])
  @@index([citizenId, createdAt(sort: Desc)])
  @@map("issues")
}

/// MUROJAAT FAYLI — fuqaro yuborgan surat/video.
///
/// ⚠️ APPEND-ONLY: murojaat bilan BIRGAGINA o'chadi (`onDelete: Cascade`).
/// Fuqaro "chiqindi uyumi" deb surat yuborgan, keyin surat yo'qolsa,
/// murojaatning asosi qolmaydi — dalil, bezak emas.
///
/// ⚠️ FAYL DISKDA, bazada emas. `path` — diskdagi `randomUUID` nomi;
/// asl nom (`originalName`) yo'l sifatida ISHLATILMAYDI (`../../.env`
/// hujumi). Tur FAYL ICHIDAN aniqlangan (`uploads.service.ts`),
/// `Content-Type` dan emas.
model IssueAttachment {
  id String @id @default(cuid())

  issueId String @map("issue_id")

  /// Baytlardan aniqlangan tur.
  kind IssueAttachmentKind

  /// Diskdagi nom (`randomUUID` + kengaytma), `/uploads/` ostida.
  path String

  /// Haqiqiy MIME (baytdan aniqlangan).
  mimeType String @map("mime_type")
  size     Int

  /// Fuqaro qurilmasidagi asl nom — faqat ma'lumot uchun saqlanadi,
  /// hech qachon yo'l sifatida ishlatilmaydi.
  originalName String? @map("original_name")

  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("issue_attachments")
}

enum IssueAttachmentKind {
  photo
  video
}

/// MUAMMO YOZISHMASI — ichki izohlar.
///
/// ⚠️ APPEND-ONLY: izoh tahrirlanmaydi ham, o'chirilmaydi ham. Bu
/// muammo bo'yicha qaror tarixi va uni qayta yozish mumkin emas. Xato
/// yozilsa — yangi izoh qo'shiladi.
model IssueComment {
  id String @id @default(cuid())

  issueId String @map("issue_id")

  /// ⚠️ XODIM YOZSA `userId`, FUQARO YOZSA `citizenId` — IKKISIDAN BIRI.
  /// Ikkisi ham `null` bo'lmasligi kerak (amaliy qoida; schema darajasida
  /// majburlanmaydi). Fuqaro izohi ("qo'shimcha") ham ro'yxatga tushadi
  /// va ma'muriyatга ko'rinadi.
  userId    String? @map("user_id")
  citizenId String? @map("citizen_id")

  body String

  /// ⚠️ `true` bo'lsa izoh MUALLIFGA (bot/fuqaroga) ham ketadi. Standart
  /// `false`: ichki muhokama tashqariga chiqmasligi kerak. Fuqaroning
  /// o'z izohi esa `true` bilan yoziladi.
  isPublic Boolean @default(false) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")

  issue   Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  citizen Citizen? @relation(fields: [citizenId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@map("issue_comments")
}

// ══════════════════════════════════════════════════════════════════════
//  SOZLAMALAR VA AUDIT
// ══════════════════════════════════════════════════════════════════════

/// TIZIM SOZLAMALARI — SINGLETON.
///
/// ⚠️ BITTA QATOR: `id` har doim `"singleton"`. Alohida `key/value`
/// jadvali emas, chunki sozlamalar soni oz va ularning TURI muhim (son,
/// bayroq, satr) — `value String` bo'lsa har o'qishda parse va tekshiruv
/// kerak bo'lardi.
model Settings {
  id String @id @default("singleton")

  /// Viloyat/tashkilot nomi — hisobot sarlavhasida.
  orgName String @default("Viloyat shtabi") @map("org_name")

  /// ── AI TAHLILI ──────────────────────────────────────────────────
  ///
  /// ⚠️ MODEL NOMI BU YERDA YO'Q. U KODDA
  /// (`signals/ai/signal-ai.constants.ts`): model almashtirish kod
  /// o'zgarishi va review'dan o'tishi kerak, tasodifiy sozlama tahriri
  /// emas. Bu yerda faqat YOQISH/O'CHIRISH va chegaralar.
  aiEnabled Boolean @default(true) @map("ai_enabled")

  /// Tahlil qancha vaqtda bir ishlaydi (daqiqa).
  ///
  /// ⚠️ CRON IFODASI QOTIB QOLMASLIGI UCHUN bazadan o'qiladi: job har
  /// daqiqada ishga tushadi va "vaqti keldimi" deb O'ZI tekshiradi
  /// (`signals.job.ts`). Cron ifodasini kodga yozib qo'ysak, uni
  /// o'zgartirish uchun deploy kerak bo'lardi.
  aiIntervalMinutes Int @default(30) @map("ai_interval_minutes")

  /// Bitta aylanishda ko'riladigan eng ko'p xabar.
  ///
  /// ⚠️ CHEGARA JOB'NI PREDSKAZUEMY QILADI: bot bir kecha ishlab,
  /// ertalab server ko'tarilsa minglab xabar yig'ilgan bo'lishi mumkin.
  /// Hammasi bitta aylanishda AI'ga ketsa — hisob ham, vaqt ham
  /// portlardi. Qolgani keyingi aylanishda ko'riladi.
  aiMaxMessagesPerRun Int @default(300) @map("ai_max_messages_per_run")

  /// Tahlil qilingan xabar qancha turib o'chiriladi (soat).
  messageRetentionHours Int @default(24) @map("message_retention_hours")

  /// ── BILDIRISHNOMA ───────────────────────────────────────────────
  ///
  /// Yuqori jiddiylikdagi signal chiqsa — shu chatlarga xabar. Bo'sh
  /// massiv = o'chirilgan.
  alertChatIds     String[]       @default([]) @map("alert_chat_ids")
  /// Qaysi darajadan boshlab xabar ketadi.
  alertMinSeverity SignalSeverity @default(high) @map("alert_min_severity")

  /// ── XAVFSIZLIK QALQONI ──────────────────────────────────────────
  ///
  /// ⚠️ BU YERDA FAQAT "NIMANI ZARARLI DEYISH" sozlanadi, qalqon
  /// YOQILISHI esa har guruhda alohida (`TelegramGroup.guardEnabled`).
  /// Bitta global tugma bilan hamma guruhda o'chirish boshlanishi
  /// mumkin emas — o'chirish qaytarib bo'lmaydigan amal.
  guardDeleteFiles Boolean @default(true) @map("guard_delete_files")
  guardDeleteUrls  Boolean @default(true) @map("guard_delete_urls")

  /// ⚠️ QORA RO'YXAT SOZLAMADA, KODDA EMAS: yangi firibgar domen
  /// har kuni paydo bo'ladi va uni qo'shish uchun deploy kutib
  /// bo'lmaydi. Model nomidan farqli o'laroq, bu ro'yxat xulosa
  /// SIFATIGA ta'sir qilmaydi — faqat qamroviga.
  guardBlockedHosts String[] @default([]) @map("guard_blocked_hosts")

  /// ⚠️ OQ RO'YXAT QORA RO'YXATDAN USTUN: rasmiy domenlar
  /// (`gov.uz`, `t.me`) hech qachon o'chirilmasligi kerak — MFY
  /// xodimi rasmiy havola tashlasa, bot uni yo'q qilib qo'ymasin.
  guardAllowedHosts String[] @default([]) @map("guard_allowed_hosts")

  /// ── MINI APP (FUQARO MUROJAATLARI) ──────────────────────────────
  ///
  /// ⚠️ CHEGARA — BLOK EMAS. Kunlik murojaat soni limiti xato
  /// ishlatayotgan odamni SEKINLATADI (`0` = cheksiz). `Citizen.isBlocked`
  /// esa butunlay yopadi — bu alohida, qattiqroq chora. Chegara sababi
  /// fuqaroga ko'rsatiladi.
  mobileDailyLimit Int @default(0) @map("mobile_daily_limit")

  /// Bitta murojaatga biriktiriladigan eng ko'p fayl.
  mobileMaxAttachments Int @default(5) @map("mobile_max_attachments")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

/// AUDIT — kim nima qildi.
///
/// ⚠️ FAQAT MUHIM AMALLAR yoziladi, har so'rov emas: login, ruxsat
/// o'zgarishi, guruhni rasmiy qilish, signalni biriktirish/yopish,
/// muammo holati. "Hamma narsani yozish" jurnalni o'qib bo'lmaydigan
/// qilardi va u o'shandan keyin hech kimga kerak bo'lmasdi.
model AuditLog {
  id String @id @default(cuid())

  userId   String? @map("user_id")
  /// "auth.login", "group.official", "signal.attach", "issue.resolve"
  action   String
  /// Qaysi obyekt ustida.
  entity   String?
  entityId String? @map("entity_id")

  /// Qo'shimcha kontekst (eski/yangi qiymat).
  meta Json?

  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════
//  XAVFSIZLIK — guruhga tashlangan zararli fayl va havolalar
// ═══════════════════════════════════════════════════════════════════

/// Nima aniqlangani.
///
/// ⚠️ TUR SAQLANADI, chunki ular BOSHQACHA ko'riladi: APK — qasddan
/// tarqatilgan dastur, qisqartirilgan havola esa ko'pincha oddiy
/// odamning e'loni. Ikkisini bitta "shubhali" qopiga solish
/// hisobotni ma'nosiz qilardi.
enum ThreatKind {
  /// Telegram orqali tashlangan o'rnatma fayl (apk, exe, msi...).
  apk_file
  /// Umuman ruxsat etilmagan turdagi hujjat.
  unknown_file
  /// Qora ro'yxatdagi yoki shubhali domen.
  suspicious_url
  /// Havolani yashiradigan qisqartirgich (bit.ly va o'xshashlari).
  shortened_url
  /// Matn ichida ko'rinadigan havola HAQIQIY manzildan farq qiladi.
  masked_url
  /// Firibgarlik matni: "davlat yordami" aldovi + ishonchsiz havola.
  scam_text
}

/// Bot nima qila oldi.
///
/// ⚠️ "ANIQLANDI" VA "O'CHIRILDI" ALOHIDA: bot admin bo'lmasa
/// o'chira OLMAYDI (Telegram ruxsat bermaydi) va bu holat panelda
/// KO'RINISHI kerak — aks holda ma'muriyat "tizim ishlayapti" deb
/// o'ylab, zararli fayl guruhda qolib ketardi.
enum ThreatAction {
  /// O'chirildi.
  deleted
  /// Aniqlandi, lekin o'chirilmadi (botda huquq yo'q yoki muddati o'tgan).
  detected
  /// O'chirishga urinildi va Telegram rad etdi.
  delete_failed
}

/// XAVFSIZLIK HODISASI — guruhda aniqlangan zararli kontent.
///
/// ⚠️ BU `GroupSignal` EMAS. Signal — AI TAXMINI va u odam qaroriga
/// muhtoj. Bu yerda esa qoida QAT'IY ("apk = zararli") va bot
/// darhol harakat qiladi. Ikkisini bitta jadvalga qo'shish
/// "signallar — taxmin" degan doktrinani buzardi.
///
/// ⚠️ YOZUV APPEND-ONLY: o'chirilmaydi va tahrirlanmaydi. Bu —
/// xavfsizlik dalili va kimdir uni "tozalab" qo'ya olmasligi kerak.
model SecurityEvent {
  id String @id @default(cuid())

  chatId    String  @map("chat_id")
  /// ⚠️ `String?`: xabar o'chirilgach Telegram'da u yo'q, lekin
  /// raqami dalil sifatida qoladi.
  messageId String? @map("message_id")

  kind   ThreatKind
  action ThreatAction

  /// ── KIM TASHLADI (muhrlangan) ───────────────────────────────────
  ///
  /// ⚠️ NUSXA OLINADI, jonli o'qilmaydi: odam guruhdan chiqib
  /// ketsa ham "kim tashlagani" hisobotda qolishi kerak.
  senderTgId     String? @map("sender_tg_id")
  senderName     String? @map("sender_name")
  senderUsername String? @map("sender_username")

  /// ── FAYL HAQIDA ─────────────────────────────────────────────────
  fileName     String? @map("file_name")
  /// Telegram aytgan MIME turi — ISHONCHSIZ (yuboruvchi o'zgartira
  /// oladi), shuning uchun kengaytma ALOHIDA saqlanadi.
  fileMime     String? @map("file_mime")
  fileSize     Int?    @map("file_size")
  /// Telegram `file_unique_id` — AYNI fayl boshqa guruhda ham
  /// tashlanganini topish uchun.
  fileUniqueId String? @map("file_unique_id")

  /// ── HAVOLA HAQIDA ───────────────────────────────────────────────
  /// Aniqlangan havola (to'liq).
  url     String?
  /// Faqat domen — hisobotda guruhlash shu bo'yicha.
  urlHost String? @map("url_host")

  /// Nima uchun zararli deb topilgani (qoida kaliti).
  reason String

  /// Xabar matni — dalil sifatida (kesilgan).
  ///
  /// ⚠️ SAQLANADI, chunki xabar O'CHIRILADI va undan keyin
  /// ma'muriyat nima yozilganini KO'RA OLMAYDI.
  messageText String? @map("message_text")

  /// Telegram rad etgan bo'lsa — sababi.
  errorMessage String? @map("error_message")

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  group TelegramGroup @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  /// ⚠️ Bir xabar ikki marta kelishi mumkin (bot qayta ishga tushdi,
  /// Telegram takrorladi) — dublikat yozuv hisobotni shishirardi.
  @@unique([chatId, messageId])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([senderTgId])
  @@map("security_events")
}

// ══════════════════════════════════════════════════════════════════════
//  FUQARO (MINI APP) — XODIMDAN BUTUNLAY ALOHIDA
// ══════════════════════════════════════════════════════════════════════

/// FUQARO — Mini App orqali murojaat yuboradigan oddiy aholi.
///
/// ⚠️ `User` EMAS. `users` — tizim XODIMLARI: parol, ruxsat ro'yxati,
/// hududiy qamrov, panelga kirish. Fuqaroda bularning HECH BIRI yo'q.
/// Ikkisini bitta jadvalga qo'shish `permissions` ustunini butun
/// aholiga tarqatardi — bitta xato standart qiymat o'nlab ming odamga
/// panel ochib qo'yardi.
///
/// ⚠️ FUQARO TOKENI UCHINCHI ALOHIDA SIR bilan imzolanadi
/// (`MOBILE_JWT_SECRET`): `typ` tekshiruvi tushib qolsa ham fuqaro
/// tokeni panelga kira olmaydi.
model Citizen {
  id String @id @default(cuid())

  /// Telegram foydalanuvchi id'si — kirish shu bo'yicha, va javob SHU
  /// chatga boradi (shaxsiy chat).
  telegramId String @unique @map("telegram_id")

  /// ── TELEGRAM'DAN (har kirishda yangilanadi) ─────────────────────
  firstName String  @map("first_name")
  lastName  String? @map("last_name")
  username  String?
  photoUrl  String? @map("photo_url")

  languageCode String @default("uz") @map("language_code")

  /// ── FUQARONING O'ZI KIRITADIGAN ─────────────────────────────────
  phone String?

  /// Hudud — murojaatni to'g'ri MFY ga yo'naltirish va yangiliklarni
  /// filtrlash uchun. Majburiy emas.
  districtId String? @map("district_id")
  mahallaId  String? @map("mahalla_id")

  /// Faollik bali — reyting shundan (`common/points.ts` yagona manba).
  points Int @default(0)

  /// ⚠️ BLOK — CHEGARADAN QATTIQROQ CHORA. Butunlay yopadi. Shuning
  /// uchun `citizens.manage` ruxsati operatorga BERILMAYDI. Sabab
  /// MAJBURIY — fuqaroga ilovada ko'rsatiladi.
  isBlocked   Boolean @default(false) @map("is_blocked")
  blockReason String? @map("block_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  mahalla  Mahalla?       @relation(fields: [mahallaId], references: [id], onDelete: SetNull)
  issues   Issue[]
  comments IssueComment[]

  @@index([points(sort: Desc)])
  @@index([districtId])
  @@map("citizens")
}

/// YANGILIK / E'LON — ilovadagi "Yangiliklar" ro'yxati.
///
/// ⚠️ TUMAN BO'YICHA FILTRLANADI: `districtId` null bo'lsa — butun
/// viloyat uchun; aks holda faqat shu tuman fuqarolariga ko'rinadi.
model Announcement {
  id String @id @default(cuid())

  title String
  body  String

  /// Muqova surati — `/uploads/` ostidagi yo'l (ixtiyoriy).
  coverPath String? @map("cover_path")

  /// Yuqoriga qadab qo'yilgan e'lon ro'yxat boshida turadi.
  isPinned Boolean @default(false) @map("is_pinned")

  /// null = butun viloyat bo'yicha.
  districtId String? @map("district_id")

  /// `null` — qoralama (ilovada ko'rinmaydi). To'ldirilsa — nashr etilgan.
  publishedAt DateTime? @map("published_at")

  /// Ko'rish sanog'i — ko'rsatkich, hisobot emas ("ot va unut").
  viewCount Int @default(0) @map("view_count")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([publishedAt(sort: Desc)])
  @@index([districtId, publishedAt(sort: Desc)])
  @@map("announcements")
}
