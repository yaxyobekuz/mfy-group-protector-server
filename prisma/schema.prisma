// ╔══════════════════════════════════════════════════════════════════════╗
// ║  E MUROJAAT — MFY guruhlaridagi muammolarni aniqlash tizimi          ║
// ╚══════════════════════════════════════════════════════════════════════╝
//
// Tizimning mohiyati bir gapda: viloyatdagi MAHALLA (MFY) Telegram
// guruhlarida aholi nima deb yozyapti — shundan ma'muriyat ko'rishi kerak
// bo'lgan MUAMMOLARNI ajratib olish.
//
// ── OQIM ──────────────────────────────────────────────────────────────
//
//   MFY guruhi            bot KUZATUVCHI sifatida o'qiydi
//        ↓                (hech narsa yozmaydi, javob bermaydi)
//   group_messages        NAVBAT — tahlilsiz xom xabar
//        ↓                AI (cron, har 30 daqiqada)
//   group_signals         AI TAXMINI — "bu gap muammoga o'xshaydi"
//        ↓                ODAM qarori (panelda kategoriya tanlaydi)
//   issues                RASMIY MUROJAAT navbati
//        ↓
//   javob → botga qaytadi (muallif qo'lda yuborgan bo'lsa)
//
// ── ASOSIY DOKTRINALAR ────────────────────────────────────────────────
//
// ⚠️ 1. SIGNAL — MUAMMO EMAS. Bu butun tizimning eng muhim qarori.
//    Xulosani AI chiqargan, ya'ni u xato bo'lishi mumkin: hazilni
//    shikoyat deb, shikoyatni hazil deb topishi mumkin. `issues` esa
//    ma'muriyat ISHONADIGAN rasmiy navbat — unga tekshirilmagan taxminni
//    qo'yish o'sha ishonchni buzardi. Shuning uchun `GroupSignal` va
//    `Issue` — IKKI ALOHIDA jadval va o'tish faqat ODAM qarori bilan
//    bo'ladi (`signals.service.ts#attach`).
//
// ⚠️ 2. GURUH → MFY → TUMAN. Hududiy kesim guruhga SOZLAMALARDA
//    biriktiriladi, Telegram'dan kelmaydi: guruh nomida "Chilonzor
//    12-MFY" deb yozilgan bo'lishi mumkin, lekin unga ishonib hisobot
//    qurish mumkin emas (nom o'zgaradi, xato yoziladi, umuman
//    yozilmaydi). Shuning uchun `mahallaId` QO'LDA qo'yiladi va u NULL
//    bo'lishi mumkin — "hali biriktirilmagan".
//
// ⚠️ 3. HUDUDIY KO'RINISH — XODIM DARAJASIDA. E Murojaat xodimi
//    hammasini ko'radi, tuman xodimi faqat o'z tumanini. Bu
//    `User.scopeKind` + `User.districtId` bilan hal qilinadi va
//    HAR SO'ROVDA server tomonida qo'llanadi (`scope.util.ts`) —
//    frontendda emas.
//
// ⚠️ 4. BAZA BITTA VA TOZA. study-tracker'dagi multi-tenant (platform +
//    br_<kod> schema'lari, AsyncLocalStorage Proxy) bu yerda YO'Q va
//    kerak ham emas: E Murojaat — BITTA tashkilot. Hududiy ajratish
//    ma'lumot darajasida (FK), ulanish darajasida emas.
//
// ── SANA VA VAQT ──────────────────────────────────────────────────────
//
// ⚠️ Butun tizim Asia/Tashkent (+5, DST yo'q). Barcha `DateTime` —
//    haqiqiy INSTANT (UTC'da saqlanadi, Toshkent devor-soatida
//    ko'rsatiladi). "UTC yarim tunidagi KUN" naqshi bu yerda YO'Q:
//    kun aniqligidagi maydon umuman ishlatilmaydi, shuning uchun
//    "sana bir kunga siljidi" klassik xatosi tug'ilmaydi ham.

generator client {
  provider = "prisma-client-js"

  // ⚠️ `output` BERILMAYDI — client `node_modules/.prisma/client` ga
  // chiqadi va `@prisma/client` orqali import qilinadi.
  //
  // `../src/generated/prisma` ga chiqarish vasvasasi bor (turlar
  // ko'rinib turadi), lekin u ISHLAB CHIQARISHDA SINDIRADI:
  // `tsconfig.build.json` `src/generated` ni chiqarib tashlaydi
  // (u generatsiya qilingan kod, versiyalanmaydi), natijada
  // `dist/` ichida client YO'Q bo'lib qoladi va server
  // `MODULE_NOT_FOUND` bilan yiqiladi. Build esa muvaffaqiyatli
  // o'tadi — xato faqat ishga tushirishda chiqadi.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════
//  HUDUD — tuman → MFY
// ══════════════════════════════════════════════════════════════════════

/// TUMAN (yoki shahar) — hududiy birlikning yuqori darajasi.
///
/// ⚠️ VILOYAT JADVALI YO'Q va bu ataylab: tizim BITTA viloyat uchun
/// ishlaydi (nomi `Settings.orgName` da). Viloyatlar jadvali qo'shilsa,
/// u darhol bo'sh ierarxiya qatlamiga aylanardi — har so'rovda `where`
/// ga qo'shiladigan, lekin hech qachon birdan ortiq qatori bo'lmaydigan
/// jadval.
model District {
  id String @id @default(cuid())

  /// ── AHOLI SONI ─────────────────────────────────────────
  ///
  /// ⚠️ NISBIY KO'RSATKICH UCHUN: "Ulug'norda 50 ta, Asakada 450 ta
  /// murojaat" degan raqam HECH NARSA aytmaydi — Asaka shunchaki
  /// kattaroq. "Har 1000 kishiga 20 ta va 18 ta" esa ikkisini
  /// SOLISHTIRIB bo'ladigan qiladi.
  ///
  /// ⚠️ MFY LAR YIG'INDISIDAN ALOHIDA: MFY aholisi to'liq
  /// to'ldirilmagan bo'lishi mumkin va o'shanda yig'indi tumanni
  /// sun'iy ravishda "kichik" ko'rsatib, nisbiy sonni osmonga
  /// ko'tarardi. Bo'sh bo'lsa — yig'indi ZAXIRA sifatida ishlatiladi
  /// (`reports.service.ts`).
  population Int?

  /// Qisqa kod — URL va import uchun ("chilonzor").
  code String @unique
  name String

  /// Ro'yxatdagi tartib — alifbo emas, ma'muriy tartib ko'pincha boshqa.
  sortOrder Int @default(0) @map("sort_order")

  /// TUMAN CHEGARASI — GeoJSON `Polygon`/`MultiPolygon`.
  ///
  /// ⚠️ IXTIYORIY (`Mahalla.geoJson` bilan ayni qoida): chegara
  /// tashqi manbadan keladi va u bo'lmasa xarita ISHLASHDA DAVOM
  /// ETADI — tuman qatlami shunchaki chizilmaydi. Majburiy
  /// qilinsa, reyestrga yangi tuman qo'shish chegara topilmaguncha
  /// bloklanardi.
  ///
  /// ⚠️ IMPORT NOM BO'YICHA BORADI (`tools/import-boundaries.mjs`):
  /// tashqi manbada bizning id'larimiz yo'q.
  geoJson Json? @map("geo_json")

  /// ⚠️ O'CHIRILMAYDI, ARXIVLANADI: tumanga biriktirilgan MFY, guruh,
  /// signal va muammolar tarixi qoladi.
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mahallas      Mahalla[]
  users         User[]
  citizens      Citizen[]
  announcements Announcement[]
  broadcasts    Broadcast[]
  organizations Organization[]
  orgRoutes     OrganizationRoute[]

  @@index([isArchived, sortOrder])
  @@map("districts")
}

/// MAHALLA (MFY) — hududiy birlikning quyi darajasi va tizimning asosiy
/// kuzatuv obyekti.
///
/// ⚠️ BITTA MFY — BIR NECHTA GURUH bo'lishi mumkin (aholi guruhi,
/// e'lonlar kanali, yoshlar guruhi). Shuning uchun bog'lanish
/// `TelegramGroup.mahallaId` da, bu yerda emas.
model Mahalla {
  id String @id @default(cuid())

  districtId String @map("district_id")

  code String @unique
  name String

  /// Raisning ismi va telefoni — muammo bo'yicha kim bilan gaplashish
  /// kerakligi panelda darhol ko'rinishi uchun.
  chairmanName  String? @map("chairman_name")
  chairmanPhone String? @map("chairman_phone")

  /// Aholi soni — hisobotda "1000 aholiga nechta murojaat" kesimi uchun.
  /// Majburiy emas: ko'pincha noma'lum va uni majburlash ma'lumot
  /// kiritishni butunlay to'xtatib qo'yardi.
  population Int?

  /// ── GEOMETRIYA — XARITA UCHUN ────────────────────────
  ///
  /// ⚠️ IKKALASI HAM IXTIYORIY va bu ataylab: MFY chegaralari
  /// RASMIY MANBADAN keladi (kadastr, OSM eksporti) va ular hamma
  /// MFY uchun birdan topilmaydi. Maydon majburiy qilinsa, chegarasi
  /// yo'q MFY ni umuman yaratib bo'lmasdi.
  ///
  /// ⚠️ `geoJson` — GeoJSON `Polygon`/`MultiPolygon` GEOMETRIYASI
  /// (`Feature` emas): xarita uni to'g'ridan-to'g'ri chizadi va
  /// o'rash qatlami qo'shilsa, import qilgan odam qaysi shaklni
  /// berishni bilmasdi.
  ///
  /// ⚠️ `lat`/`lng` — YORLIQ MARKAZI. Chegara bo'lmasa ham u
  /// bo'lishi mumkin — o'shanda xarita poligon o'rniga DOIRA
  /// chizadi va "qayerda nima ko'p" savoli javobsiz qolmaydi.
  geoJson Json?  @map("geo_json")
  lat     Float?
  lng     Float?

  sortOrder Int @default(0) @map("sort_order")

  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district   District          @relation(fields: [districtId], references: [id], onDelete: Restrict)
  groups     TelegramGroup[]
  issues     Issue[]
  citizens   Citizen[]
  assignees  MahallaAssignee[]
  broadcasts Broadcast[]

  @@index([districtId, isArchived, sortOrder])
  @@map("mahallas")
}

// ══════════════════════════════════════════════════════════════════════
//  XODIMLAR VA RUXSAT
// ══════════════════════════════════════════════════════════════════════

/// Xodimning HUDUDIY ko'rinish darajasi.
///
/// ⚠️ BU RUXSAT EMAS, QAMROV. Ruxsat "nima qila oladi" (`permissions`),
/// qamrov esa "kimning ma'lumotini ko'radi". Ikkisi ALOHIDA: tuman
/// xodimi ham signalni muammoga biriktira oladi, lekin faqat o'z
/// tumanidagi guruhdan chiqqanini.
enum ScopeKind {
  /// Butun viloyat — barcha tumanlar.
  province
  /// Faqat `User.districtId` dagi tuman.
  district

  /// TASHKILOT XODIMI — faqat O'Z tashkilotiga yo'naltirilgan
  /// murojaatlar (`User.organizationId`).
  ///
  /// ⚠️ BU HUDUDIY QAMROV EMAS va shuning uchun uchinchi qiymat
  /// kerak bo'ldi: suv ta'minoti tashkiloti o'z tumanidagi HAMMA
  /// murojaatni emas, faqat O'ZIGA tegishlisini ko'radi. Tuman
  /// qamroviga qo'yilsa, u qo'shnisining gaz va yo'l muammolarini
  /// ham ko'rib turardi.
  ///
  /// ⚠️ MAVJUD HUDUDIY FUNKSIYALAR (`mahallaScopeWhere`,
  /// `districtScopeWhere`) bu xodimga HECH NARSA bermaydi —
  /// `districtId` si yo'q, ya'ni `impossible` filtri ishlaydi. Bu
  /// ATAYLAB: biror modulni `issueScopeWhere` ga o'tkazish
  /// unutilsa, tashkilot xodimi hech narsa ko'rmaydi — hammasini
  /// emas ("ochib qo'yishdan xavfsizroq").
  org
}

enum UserRole {
  /// Tizim egasi — hamma narsa, ruxsat tekshirilmaydi.
  owner
  /// Shtab ma'muriyati.
  admin
  /// Operator — signal ko'radi, muammo yuritadi.
  operator
  /// Faqat o'qiydi (hisobot uchun).
  viewer
}

model User {
  id String @id @default(cuid())

  /// ⚠️ Login butun tizim bo'ylab YAGONA. Bu study-tracker'dagi
  /// `platform.user_directory` ning soddalashtirilgan ko'rinishi: baza
  /// bitta bo'lgani uchun alohida reyestr kerak emas, `@unique` yetarli.
  username     String @unique
  /// ⚠️ ARGON2ID HASH. Bcrypt emas: argon2id — hozirgi tavsiya (OWASP)
  /// va bcrypt'ning 72-bayt kesilishi muammosi yo'q.
  passwordHash String @map("password_hash")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  role UserRole @default(operator)

  /// ── QAMROV ──────────────────────────────────────────────────────
  ///
  /// ⚠️ `district` bo'lsa `districtId` MAJBURIY. Bazada buni ifodalash
  /// mumkin emas (shartli NOT NULL), shuning uchun tekshiruv service'da
  /// (`users.service.ts`). Qo'yilmasa xodim HECH NARSA ko'rmaydi —
  /// ochib qo'yishdan ko'ra xavfsizroq.
  scopeKind  ScopeKind @default(district) @map("scope_kind")
  districtId String?   @map("district_id")

  /// ── TASHKILOT XODIMI ────────────────────────────────────────────
  ///
  /// ⚠️ `scopeKind == org` BO'LSA MAJBURIY (tekshiruv service'da —
  /// `districtId` bilan ayni sabab: shartli NOT NULL ni bazada
  /// ifodalash mumkin emas). Qo'yilmasa xodim HECH NARSA ko'rmaydi.
  ///
  /// ⚠️ TASHKILOT XODIMI HAM `User`, UCHINCHI JADVAL EMAS: u panelga
  /// KIRADI, ya'ni `Citizen`/`User` ajratilgan sabab ("`permissions`
  /// butun aholiga tarqalardi") bu yerga tegishli emas. Uchinchi
  /// jadval uchinchi sir, uchinchi guard va uchinchi sessiya
  /// jadvalini talab qilardi — barchasi ayni ishni qilib.
  organizationId String? @map("organization_id")

  /// ── TAYYOR PAROLNI ALMASHTIRISH ─────────────────────────────────
  ///
  /// ⚠️ TASHKILOTGA PAROL QOG'OZDA BERILADI ("app ijro" o'rniga
  /// tayyor login-parol). Almashtirish majburiy bo'lmasa, yuzlab
  /// tashkilotning paroli tizimda ABADIY qolardi — va ularning
  /// ro'yxati bir marta tarqalsa, hammasi birdan ochilib ketardi.
  ///
  /// ⚠️ MAVJUD XODIMLARGA TEGMAYDI (`false`): migratsiya tirik
  /// bazada ishlaydi va shtab xodimlari ertalab panelga kirganda
  /// to'siqqa urilmasligi kerak.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  /// Ruxsatlar — `common/permissions.ts` dagi katalogdan olingan
  /// satrlar ("groups.manage", "signals.attach", ...).
  ///
  /// ⚠️ MASSIV, ALOHIDA JADVAL EMAS. Ruxsatlar soni o'nlab va ular
  /// FAQAT shu xodim bilan birga o'qiladi — join qiladigan narsa yo'q.
  /// `owner` uchun bu massiv umuman o'qilmaydi.
  permissions String[] @default([])

  isActive   Boolean   @default(true) @map("is_active")
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  /// Telegram bog'lanishi — xodim botdan muammo yuborishi uchun.
  ///
  /// ⚠️ BITTA TELEGRAM — BITTA XODIM (`@unique`). Aks holda bir
  /// telegramdan kelgan muammo kim nomidan yozilganini aniqlash
  /// mumkin bo'lmasdi.
  telegramId String? @unique @map("telegram_id")

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  /// ⚠️ `onDelete: SetNull`: tashkilot arxivlanadi, o'chirilmaydi —
  /// lekin o'chirilsa ham xodim yozuvi (va uning auditdagi izi)
  /// qolishi kerak.
  organization Organization? @relation("OrgStaff", fields: [organizationId], references: [id], onDelete: SetNull)

  orgDoneIssues    Issue[]             @relation("IssueOrgDoneBy")
  createdOrgRoutes OrganizationRoute[] @relation("OrgRouteAuthor")

  officialGroups   TelegramGroup[]   @relation("GroupOfficialBy")
  guardedGroups    TelegramGroup[]   @relation("GroupGuardBy")
  attachedSignals  GroupSignal[]     @relation("SignalAttachedBy")
  dismissedSignals GroupSignal[]     @relation("SignalDismissedBy")
  authoredIssues   Issue[]           @relation("IssueAuthor")
  assignedIssues   Issue[]           @relation("IssueAssignee")
  reviewedIssues   Issue[]           @relation("IssueReviewedBy")
  issueComments    IssueComment[]
  sessions         Session[]
  assignmentRules  MahallaAssignee[] @relation("AssignmentRuleUser")
  createdRules     MahallaAssignee[] @relation("AssignmentRuleAuthor")
  broadcasts       Broadcast[]

  @@index([role, isArchived])
  @@index([districtId])
  /// ⚠️ XABARNOMA MANZILI SHU INDEKSDAN O'QILADI: tashkilotga
  /// `telegramChatId` qo'yilmagan bo'lsa, xabar uning FAOL
  /// xodimlariga ketadi (`issue-notify.service.ts`).
  @@index([organizationId, isArchived])
  @@map("users")
}

/// REFRESH TOKEN SESSIYASI.
///
/// ⚠️ TOKEN O'ZI SAQLANMAYDI — faqat SHA-256 hash'i. Baza o'qib
/// ketilsa, o'g'irlangan hash bilan kirish mumkin emas.
///
/// ⚠️ ROTATSIYA: har yangilanishda eski qator `revokedAt` oladi va
/// YANGISI yoziladi. Bir refresh token IKKI MARTA ishlatilsa — bu
/// o'g'irlanish belgisi va o'sha xodimning BARCHA sessiyalari yopiladi
/// (`auth.service.ts#refresh`).
model Session {
  id String @id @default(cuid())

  userId String @map("user_id")

  tokenHash String @unique @map("token_hash")

  userAgent String? @map("user_agent")
  ip        String?

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ══════════════════════════════════════════════════════════════════════
//  TELEGRAM GURUHLARI
// ══════════════════════════════════════════════════════════════════════

/// BOT KO'RGAN GURUH/KANAL — reyestr.
///
/// ── NIMA UCHUN REYESTR KERAK ──────────────────────────────────────
///
/// ⚠️ Telegram Bot API'da "men qaysi guruhlarda a'zoman" degan savolga
/// javob beradigan metod YO'Q. `getChats` faqat MTProto'da, ya'ni bot
/// emas, ODAM nomidan ulanishda mavjud. Bot faqat O'ZIGA kelgan
/// hodisadan biladi, shuning uchun ro'yxatni biz to'playmiz:
///
///   my_chat_member   → botning holati o'zgardi (asosiy manba)
///   guruhdagi xabar  → zaxira (hodisa o'tkazib yuborilgan bo'lsa)
///
/// ⚠️ O'TMISHGA QARAMAYDI: bot bu kod joylashtirilishidan OLDIN a'zo
/// bo'lgan guruh ro'yxatga O'ZI tushmaydi — Telegram o'tgan
/// hodisalarni qayta yubormaydi. Bunday guruh unda biror harakat
/// bo'lgandan keyin tushadi (huquq o'zgarishi yoki oddiy xabar), shu
/// sababli zaxira yo'l bor.
model TelegramGroup {
  /// ⚠️ `chatId` — PK va TABIIY kalit: Telegram beradi, biz generatsiya
  /// qilmaymiz. `String`, `BigInt` emas — Telegram chat id'lari katta
  /// manfiy sonlar va ular bilan arifmetika qilinmaydi.
  chatId String @id @map("chat_id")

  /// group | supergroup | channel. `private` BU YERGA TUSHMAYDI —
  /// shaxsiy chat bu bog'lanish, guruh emas.
  type  String @default("group")
  title String

  /// Ommaviy guruhda bor, yopiqda yo'q. Xabar havolasining SHAKLI
  /// shunga bog'liq (`signals.service.ts#buildMessageLink`).
  username String?

  /// Telegram `ChatMember.status` — bot hali ichidami.
  status String @default("member")

  canPostMessages Boolean @default(false) @map("can_post_messages")
  canInviteUsers  Boolean @default(false) @map("can_invite_users")

  /// ── QALQON ISHLAY OLADIMI ───────────────────────────────────────
  ///
  /// ⚠️ `guardEnabled` — MA'MURIYAT XOHISHI, bu esa TELEGRAM
  /// RUXSATI. Ikkisi boshqa-boshqa: qalqon yoqilgan bo'lishi, lekin
  /// bot guruhda administrator bo'lmagani uchun hech narsa o'chira
  /// olmasligi mumkin. Telegram o'shanda `400: message can't be
  /// deleted` deb qaytaradi va SABABNI aytmaydi — panelda esa
  /// "himoya ishlayapti" degan taassurot qolardi.
  ///
  /// ⚠️ IKKI MANBADAN TO'LADI: `my_chat_member` hodisasi (huquq
  /// o'zgarganda) va o'chirish urinishi natijasi
  /// (`bot/features/guard/delete-failure.ts`). Birinchisi bot shu
  /// kod joylashtirilgandan KEYIN qo'shilgan guruhlarda ishlaydi,
  /// ikkinchisi esa eskilarida — shuning uchun ikkalasi ham kerak.
  canDeleteMessages Boolean @default(false) @map("can_delete_messages")

  /// ── A'ZOLAR SONI ────────────────────────────────────────────────
  ///
  /// ⚠️ TELEGRAM'DAN O'QILADI (`getChatMemberCount`) va NUSXA
  /// sifatida saqlanadi: panel ro'yxatni ko'rsatayotganda har guruh
  /// uchun Telegram'ga borish mumkin emas (yuzlab guruh — yuzlab
  /// so'rov va chegara).
  ///
  /// ⚠️ `null` — "hali o'qilmagan", `0` dan BOSHQA narsa. Nol deb
  /// yozilsa, panel "guruhda hech kim yo'q" deb ko'rsatardi.
  memberCount   Int?      @map("member_count")
  memberCountAt DateTime? @map("member_count_at")

  /// ── KUZATUVGA ROZILIK ───────────────────────────────────────────
  ///
  /// ⚠️ `isOfficial` — PANELDA qo'yiladigan belgi va bot unga HECH
  /// QACHON tegmaydi. Ma'nosi: "bu guruh yozishmasini o'qishga
  /// ruxsat". Reyestrda bot tasodifan qo'shilgan, test va umuman
  /// begona guruhlar ham bor — ularning yozishmasini o'qish mumkin
  /// emas. Belgi bo'lmasa xabar NAVBATGA HAM TUSHMAYDI
  /// (`group-watch.service.ts`).
  isOfficial Boolean   @default(false) @map("is_official")
  officialAt DateTime? @map("official_at")
  officialBy String?   @map("official_by")

  /// ── HUDUDIY BIRIKTIRISH ─────────────────────────────────────────
  ///
  /// ⚠️ TELEGRAM'DAN KELMAYDI, QO'LDA QO'YILADI (schema boshidagi
  /// 2-doktrina). `null` = "hali biriktirilmagan" va bu NORMAL holat:
  /// bot yangi guruhga qo'shilganda shunday bo'ladi. Panelda bunday
  /// guruhlar alohida ajratib ko'rsatiladi.
  mahallaId String? @map("mahalla_id")

  addedByTgId String? @map("added_by_tg_id")

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// ── XAVFSIZLIK QALQONI ──────────────────────────────────────────
  ///
  /// ⚠️ `isOfficial` DAN ALOHIDA va bu ATAYLAB. `isOfficial` —
  /// yozishmani O'QISHGA rozilik; qalqon esa aholini himoya qiladi
  /// va "o'qimayman" degan guruhda ham kerak bo'lishi mumkin.
  /// Ikkisini bitta belgiga bog'lash "kuzatuvni yoqmagunimcha
  /// viruslardan himoya ham yo'q" degan noto'g'ri bog'liqlik
  /// yaratardi.
  ///
  /// ⚠️ STANDART `false`: bot guruhga qo'shilishi bilan xabar
  /// o'chira boshlashi mumkin emas. Ma'muriyat buni ATAYLAB
  /// yoqadi — o'chirish qaytarib bo'lmaydigan amal.
  guardEnabled Boolean   @default(false) @map("guard_enabled")
  guardAt      DateTime? @map("guard_at")
  guardBy      String?   @map("guard_by")

  mahalla        Mahalla?        @relation(fields: [mahallaId], references: [id], onDelete: SetNull)
  officialUser   User?           @relation("GroupOfficialBy", fields: [officialBy], references: [id], onDelete: SetNull)
  guardUser      User?           @relation("GroupGuardBy", fields: [guardBy], references: [id], onDelete: SetNull)
  messages       GroupMessage[]
  signals        GroupSignal[]
  securityEvents SecurityEvent[]

  @@index([isOfficial, status])
  @@index([mahallaId])
  @@map("telegram_groups")
}

/// RASMIY GURUHDAN KELGAN XABAR — AI tahlili uchun XOMASHYO.
///
/// ⚠️ BU NAVBAT, ARXIV EMAS. Tahlildan keyin belgilanadi va 24 soatdan
/// so'ng O'CHIRILADI (`signals.service.ts#sweep`). Sabab ikkita:
/// (1) bu aholining shaxsiy yozishmasi va uni saqlab qolish kerak emas,
/// (2) xato tekshirish uchun bir necha soat yetarli ("signal nimadan
/// chiqdi?").
///
/// ⚠️ MATN BO'LMASA YOZILMAYDI. Stiker, rasm, ovozli xabar va xizmat
/// xabarlari (kirdi/chiqdi) tahlilga hech narsa bermaydi, lekin
/// navbatni va AI hisobini shishirardi. Rasm izohi (`caption`) esa
/// matn — u olinadi.
model GroupMessage {
  id String @id @default(cuid())

  chatId    String @map("chat_id")
  /// Telegram `message_id` — havola shundan quriladi.
  messageId String @map("message_id")

  senderTgId String? @map("sender_tg_id")
  senderName String? @map("sender_name")

  text String

  /// Nimaga javob ekani. "Ha, menda ham shunday" degan xabar o'zicha
  /// ma'nosiz, javob bo'lgani bilan ma'noli — model shuni ko'radi.
  replyToText String? @map("reply_to_text")

  sentAt DateTime @map("sent_at")

  /// ⚠️ NULL = navbatda. AI yiqilsa bu ustun QO'YILMAYDI va xabar
  /// keyingi aylanishda qayta ko'riladi — aks holda u tahlilsiz qolib
  /// ketardi.
  analyzedAt DateTime? @map("analyzed_at")

  createdAt DateTime @default(now()) @map("created_at")

  group TelegramGroup @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  /// ⚠️ Bir xabar ikki marta kelishi mumkin (bot qayta ishga tushdi,
  /// Telegram takrorladi). Unique bo'lmasa navbatda dublikat paydo
  /// bo'lib, AI bir gapni ikki marta ko'rardi.
  @@unique([chatId, messageId])
  @@index([analyzedAt, sentAt])
  @@map("group_messages")
}

// ══════════════════════════════════════════════════════════════════════
//  SIGNALLAR — AI TAXMINI
// ══════════════════════════════════════════════════════════════════════

/// AI topgan toifa.
enum SignalKind {
  /// Shikoyat, norozilik, nosozlik haqida xabar.
  complaint
  /// Taklif, yaxshilash istagi.
  suggestion
  /// Javobsiz qolgan savol.
  question
}

enum SignalSeverity {
  low
  normal
  high
}

enum SignalStatus {
  /// Hali ko'rilmagan.
  new
  /// Muammoga aylantirilgan.
  attached
  /// "Bu muammo emas".
  dismissed
}

/// AI TOPGAN SIGNAL — "bu gap muammoga o'xshaydi".
///
/// ⚠️ SIGNAL — MUAMMO EMAS (schema boshidagi 1-doktrina). Bu jadval AI
/// TAXMINLARI uchun, `Issue` esa ma'muriyat ishonadigan rasmiy navbat
/// uchun.
///
/// ⚠️ MANBA XABARDAN KO'CHIRIB OLINADI, FK bilan bog'lanmaydi:
/// `group_messages` 24 soatdan keyin o'chiriladi, signal esa qoladi.
/// Shuning uchun `senderName`, `sentAt` va matn SHU YERGA muhrlanadi.
///
/// ⚠️ MATNNI AI YOZMAYDI. `summary` — XABARNING O'Z MATNI. AI faqat
/// TANLAYDI (bu gap signalga arziydimi) va TOIFALAYDI. Sabab: AI yozgan
/// xulosa har safar "...haqida shikoyat bor" degan o'ramga aylanib,
/// odamning o'z gapini uzoqlashtiradi. Odam shikoyatni o'z so'zi bilan
/// o'qiganda tezroq tushunadi.
model GroupSignal {
  id String @id @default(cuid())

  chatId    String  @map("chat_id")
  /// ⚠️ `String?`: xabar o'chirilgan bo'lsa ham signal qoladi, faqat
  /// havolasi bo'lmaydi.
  messageId String? @map("message_id")

  kind     SignalKind
  severity SignalSeverity @default(normal)
  /// Xabarning O'Z matni (kesilgan bo'lishi mumkin).
  summary  String

  /// ── MANBA (muhrlangan) ──────────────────────────────────────────
  senderTgId String?   @map("sender_tg_id")
  senderName String?   @map("sender_name")
  sentAt     DateTime? @map("sent_at")

  /// AI nechta xabarni ko'rib shu xulosaga kelgan — qamrov.
  messageCount Int @default(1) @map("message_count")

  /// Qaysi model chiqargan. Model almashganda eski signallarni ajratish
  /// uchun ("bu xulosani qaysi versiya bergan").
  model String?

  status SignalStatus @default(new)

  /// Biriktirilgan bo'lsa — qaysi muammoga.
  ///
  /// ⚠️ `@unique`: bir signal IKKI muammoga aylanmaydi. Bu
  /// `attach()` dagi holat tekshiruvining baza darajasidagi kafolati —
  /// ikki operator bir vaqtda bosgan holatda ham.
  issueId    String?   @unique @map("issue_id")
  attachedBy String?   @map("attached_by")
  attachedAt DateTime? @map("attached_at")

  /// ⚠️ E'tiborsiz qoldirilgan signal O'CHIRILMAYDI: AI nimani
  /// noto'g'ri topganini ko'rish kerak (prompt shunga qarab
  /// tuzatiladi). Ro'yxat standart holda faqat yangilarini ko'rsatadi,
  /// ya'ni bu yozuvlar ishga xalaqit bermaydi.
  dismissedBy     String?   @map("dismissed_by")
  dismissedAt     DateTime? @map("dismissed_at")
  dismissedReason String?   @map("dismissed_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group         TelegramGroup @relation(fields: [chatId], references: [chatId], onDelete: Cascade)
  issue         Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)
  attachedUser  User?         @relation("SignalAttachedBy", fields: [attachedBy], references: [id], onDelete: SetNull)
  dismissedUser User?         @relation("SignalDismissedBy", fields: [dismissedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([chatId, status])
  @@index([severity, status])
  @@map("group_signals")
}

// ══════════════════════════════════════════════════════════════════════
//  MUAMMOLAR — RASMIY NAVBAT
// ══════════════════════════════════════════════════════════════════════

/// Muammo qayerdan keldi.
///
/// ⚠️ MANBA MUHRLANADI va o'zgarmaydi. Hisobotda "AI nechta muammo
/// topdi, odam nechta yubordi" degan savolga javob shu ustundan chiqadi
/// — AI'ning foydasini o'lchashning yagona yo'li.
enum IssueSource {
  /// AI signalidan biriktirilgan.
  signal
  /// Botdan qo'lda yuborilgan.
  bot
  /// Panelda qo'lda yaratilgan.
  manual
  /// Fuqaro Mini App orqali o'zi yuborgan.
  ///
  /// ⚠️ `signal` DAN FARQI: bu yerda "bu muammomi?" degan AI taxmini
  /// YO'Q — fuqaro atayin yuborgan. Shuning uchun `group_signals`
  /// bosqichidan o'tmaydi va to'g'ridan-to'g'ri rasmiy navbatga tushadi.
  mobile
}

enum IssueStatus {
  /// Yangi — hech kim ko'rmagan.
  new
  /// Ko'rib chiqilmoqda.
  in_progress
  /// Hal qilindi.
  resolved
  /// Rad etildi (muammo emas / hududimizga tegishli emas).
  rejected
}

enum IssuePriority {
  low
  normal
  high
  urgent
}

/// MUROJAAT KATEGORIYASI — panelda sozlanadi.
///
/// ⚠️ BOT YARATMAYDI, faqat FAOL bo'lganlarini ko'rsatadi. Kategoriya
/// yo'q bo'lsa botdagi oqim BOSHLANMAYDI (`categoryId` majburiy).
model IssueCategory {
  id String @id @default(cuid())

  name  String  @unique
  /// Panelda rang bilan ajratish uchun (hex).
  color String?

  description String?

  /// ── ILOVA UCHUN QO'SHILGAN ──────────────────────────────────────
  ///
  /// ⚠️ ILOVAGA ALOHIDA TOIFA OCHILMAYDI: bu — `issue_categories` ning
  /// O'ZI. Botdan va ilovadan kelgan murojaat bir xil yo'nalishga
  /// tushadi. Ilova uchun qo'shilgani faqat ko'rinish/vaqt/tashkilot.
  ///
  /// ⚠️ `icon` — KALIT (SVG emas): `mobile/.../icons.tsx` va
  /// `admin/.../category-icons.ts` dagi kalit. Tanilmagan kalit zahira
  /// belgi beradi — toifa qo'shishni to'smaydi.
  icon String?

  /// Taxminiy javob muddati (soat) — ilovada "3 kun" deb ko'rsatiladi
  /// (`slaLabel`). Muddat MAJBURIYAT EMAS, mo'ljal (`Issue.dueAt` bilan
  /// ayni mantiq).
  slaHours Int @default(72) @map("sla_hours")

  /// Mas'ul tashkilot nomi — ilovada "Mas'ul tashkilot" qatorida.
  /// Bo'sh bo'lsa ilova `Settings.orgName` ni ko'rsatadi.
  ///
  /// ⚠️ MATN, HAVOLA EMAS — VA SHUNDAY QOLADI. `Organization` jadvali
  /// qo'shilgandan keyin ham bu ustun olib tashlanmaydi: u ZAXIRA.
  /// Yo'naltirish qoidasi (`OrganizationRoute`) qo'yilmagan
  /// yo'nalishda ilova baribir "Mas'ul tashkilot" qatorini
  /// ko'rsatishi kerak, aks holda tizimga tashkilotlar kiritilmagan
  /// paytda ekranda bo'sh joy turardi.
  ///
  /// ⚠️ IKKISI ARALASHTIRILMAYDI: `orgName` — fuqaroga ko'rinadigan
  /// MATN, `Organization` — murojaat BORADIGAN manzil (hisobi,
  /// xabarnomasi va yo'naltirish qoidasi bor). Qoida topilsa
  /// tashkilotning haqiqiy nomi ko'rsatiladi, topilmasa shu matn.
  orgName String? @map("org_name")

  sortOrder Int @default(0) @map("sort_order")

  /// ⚠️ YUMSHOQ O'CHIRISH: o'chirilgan kategoriya tugmasi botda darhol
  /// yo'qoladi, lekin ESKI MUAMMOLAR o'z kategoriyasini saqlab qoladi.
  /// Qattiq o'chirish tarixni buzardi.
  isActive Boolean @default(true) @map("is_active")

  /// ── KICHIK YO'NALISH (ota-bola) ───────────────────────
  ///
  /// ⚠️ IKKINCHI RO'YXAT OCHILMADI, SHU RO'YXAT CHUQURLASHTIRILDI.
  /// "Yo'nalishlar ilovaga alohida ochilmaydi" doktrinasi kuchda:
  /// bot ham, ilova ham, AI ham AYNI jadvalni o'qiydi. Ilova uchun
  /// alohida mayda toifalar ochilsa, botdan va ilovadan kelgan
  /// murojaatlar boshqa-boshqa yo'nalishga tushib, hisobotda IKKITA
  /// ro'yxat paydo bo'lardi.
  ///
  /// ⚠️ CHUQURLIK — ATIGI IKKI DARAJA. Uch daraja ("Kommunal →
  /// Suv → Ichimlik suvi → Bosim") hisobotni ham, botdagi tanlovni
  /// ham o'qib bo'lmaydigan qilardi. Shuning uchun BOLANING BOLASI
  /// bo'lmaydi — tekshiruv `categories.service.ts` da.
  ///
  /// ⚠️ `onDelete: Restrict`: ichida kichik yo'nalishlari bor
  /// yo'nalishni o'chirish bolalarni "egasiz" qoldirardi.
  parentId String? @map("parent_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent    IssueCategory?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  IssueCategory[]     @relation("CategoryTree")
  issues    Issue[]
  assignees MahallaAssignee[]
  orgRoutes OrganizationRoute[]

  @@index([isActive, sortOrder])
  @@index([parentId, sortOrder])
  @@map("issue_categories")
}

/// RASMIY MUROJAAT — ma'muriyat ishlaydigan navbat.
model Issue {
  id String @id @default(cuid())

  /// Odam o'qiydigan raqam ("MFY-000123").
  ///
  /// ⚠️ KETMA-KET VA TESHIKSIZ BO'LISHI SHART EMAS — muhimi
  /// takrorlanmasligi. Teshiksizlikni kafolatlash har yaratishda
  /// jadvalni lock qilishni talab qilardi.
  publicNo String @unique @map("public_no")

  categoryId String @map("category_id")

  source IssueSource

  /// ⚠️ HUDUD MUAMMOGA MUHRLANADI, guruhdan JONLI o'qilmaydi. Guruhning
  /// MFY biriktirishi keyinroq o'zgarishi mumkin (xato tuzatildi, guruh
  /// boshqa mahallaga o'tdi) va o'shanda o'tgan hisobot JIMGINA qayta
  /// yozilardi: "mart oyida Chilonzorda 12 ta murojaat" degan raqam
  /// o'zgarib ketardi.
  mahallaId String? @map("mahalla_id")

  title String
  body  String

  status   IssueStatus   @default(new)
  priority IssuePriority @default(normal)

  /// ── MUALLIF ─────────────────────────────────────────────────────
  ///
  /// ⚠️ `authorId` — TIZIM XODIMI. Guruhda yozgan aholi tizimda
  /// foydalanuvchi EMAS, shuning uchun signal biriktirilganda muallif
  /// BIRIKTIRGAN ODAM bo'ladi. Haqiqiy manba yo'qolmaydi: ismi, guruh
  /// nomi va xabar havolasi `sourceMeta` da qoladi.
  authorId String? @map("author_id")

  /// ⚠️ FUQARO — XODIM EMAS. `authorId` TIZIM XODIMI (`User`), bu esa
  /// Mini App'dan yuborgan FUQARO (`Citizen`). Ikkisi ALOHIDA ustun:
  /// bir jadvalga qo'shilsa `permissions` butun aholiga tarqalardi.
  /// Mobil murojaatda `authorId` null, `citizenId` to'ladi.
  citizenId String? @map("citizen_id")

  /// Botdan kelgan bo'lsa — javob AYNAN SHU chatga qaytadi, keyin
  /// bog'lanish uzilsa ham.
  ///
  /// ⚠️ SIGNALDAN VA MOBILDAN KELGANDA ATAYLAB BO'SH: javob MFY
  /// guruhiga ketib qolmasligi kerak — bot u yerda KUZATUVCHI. Mobil
  /// javob fuqaroning SHAXSIY chatiga boradi (`citizen.telegramId`),
  /// manzil bir joyda saqlanadi.
  authorChatId String? @map("author_chat_id")

  /// ── MOBIL MUROJAAT MAYDONLARI (manba `mobile` bo'lganda) ─────────
  ///
  /// Xaritada qadalgan nuqta (ixtiyoriy — suratsiz/joysiz ham murojaat
  /// qabul qilinadi).
  lat            Float?
  lng            Float?
  /// Fuqaro yozgan yoki xaritadan topilgan manzil matni.
  address        String?
  /// Fuqaro belgilagan bayroqlar — TAXMIN, ustuvorlikni o'zgartirmaydi,
  /// panelda faqat ko'rsatiladi (CLAUDE.md "Ustuvorlikni AI taklifi
  /// o'zgartirmaydi" bilan ayni sabab).
  isHazard       Boolean   @default(false) @map("is_hazard")
  isLongStanding Boolean   @default(false) @map("is_long_standing")
  isRepeatAppeal Boolean   @default(false) @map("is_repeat_appeal")
  /// Muammo qachon sodir bo'lgani (fuqaro ko'rsatsa).
  occurredAt     DateTime? @map("occurred_at")

  /// Manba haqida barcha ma'lumot: guruh nomi, yozgan odam, xabar
  /// havolasi, AI toifasi.
  ///
  /// ⚠️ JSON — chunki manbaga qarab maydonlar BOSHQA bo'ladi va
  /// ularning har biri uchun ustun ochish jadvalni yarmi bo'sh
  /// ustunlar bilan to'ldirardi.
  sourceMeta Json? @map("source_meta")

  /// ── IJRO ────────────────────────────────────────────────────────
  assigneeId String? @map("assignee_id")

  /// ── IJROCHI TASHKILOT ───────────────────────────────────────────
  ///
  /// ⚠️ `assigneeId` NING O'RNINI BOSMAYDI VA U BILAN
  /// TO'QNASHMAYDI — ikkisi IKKI BOSHQA savolga javob beradi:
  ///
  ///   assigneeId     → muammoni NAZORAT qiladigan shtab xodimi
  ///   organizationId → ishni BAJARADIGAN tashkilot (suv, gaz, yo'l)
  ///
  /// Ikkisi birga to'ladi va "qaysi biri ustun" degan savol paydo
  /// bo'lmaydi. Bitta ustunga sig'dirilsa, "murojaat Suvoqovaga
  /// ketdi, lekin uni shtabda kim kuzatyapti" degan savol javobsiz
  /// qolardi.
  ///
  /// ⚠️ MUHRLANGAN NUSXA (`assigneeId`, `mahallaId` bilan ayni
  /// qoida): yo'naltirish qoidasi keyin o'zgartirilsa, ALLAQACHON
  /// yaratilgan murojaatning tashkiloti O'ZGARMAYDI. Aks holda
  /// "o'tgan oy qaysi tashkilot nechta murojaat olgan" degan
  /// hisobot jimgina qayta yozilardi.
  ///
  /// ⚠️ ESKI MUROJAATLARDA `null` VA U ORQAGA TO'LDIRILMAYDI: qoida
  /// ular yaratilganda MAVJUD EMAS edi, ya'ni tashkilotga xabar ham
  /// ketmagan. To'ldirilsa, panel "tashkilot xabardor" degan YOLG'ON
  /// ko'rsatkich berardi.
  organizationId String? @map("organization_id")

  /// ── TASHKILOT "BAJARDIM" DEB BELGILAGANI ────────────────────────
  ///
  /// ⚠️ MUROJAATNI YOPMAYDI va holatni O'ZGARTIRMAYDI. Rasmiy
  /// javobni (fuqaroning Telegram chatiga ketadigan matnni) shtab
  /// xodimi yozadi: yuzlab tashkilot hisobiga aholiga to'g'ridan-
  /// to'g'ri yozish huquqini berib bo'lmaydi va yuborilgan javobni
  /// qaytarib ham bo'lmaydi (`broadcast.send` operatorga
  /// berilmagani bilan AYNI sabab).
  ///
  /// ⚠️ SANA, BAYROQ EMAS: "qachon bajarildi" degan savol muddatga
  /// rioya qilinganini tekshirish uchun kerak — `true`/`false` esa
  /// buni aytmasdi.
  orgDoneAt DateTime? @map("org_done_at")
  orgDoneBy String?   @map("org_done_by")

  /// ⚠️ MUDDAT — MAJBURIYAT EMAS, MO'LJAL. Tizim uni o'tganda hech
  /// narsa qilmaydi (avtomatik eskalatsiya yo'q), faqat panelda
  /// ajratib ko'rsatadi. Avtomatik harakat qo'shilsa, u darhol
  /// "muddatni surib qo'yish" amaliyotini tug'dirardi.
  dueAt DateTime? @map("due_at")

  /// ── MUDDAT QAYERDAN KELDI ──────────────────────────
  ///
  /// ⚠️ "MUDDAT QANDAY BELGILANYAPTI?" — BU SAVOLGA JAVOB. Avval
  /// panelda faqat sana turardi va u qayerdan kelgani (yo'nalish
  /// SLA'simi, MFY qoidasimi, odam qo'yganmi) HECH QAYERDA
  /// ko'rinmasdi — xodim sanani "tizim o'ylab topgan" deb qabul
  /// qilardi.
  ///
  /// Qiymatlar: `category` | `rule` | `manual` | `ai`.
  ///
  /// ⚠️ MATN, ENUM EMAS: yangi manba qo'shilganda migratsiya
  /// kerak bo'lmasligi uchun. Panel tanilmagan qiymatni KALIT
  /// ko'rinishida ko'rsatadi (audit jurnalidagi ayni yondashuv).
  dueSource String? @map("due_source")

  /// ── TAKRORIY MUROJAAT (ommaviy hodisa) ──────────────────
  ///
  /// ⚠️ HAQIQIY HOLATDAN: transformator o'chsa, guruhda 20 odam
  /// "svet o'chdi" deb yozadi. Ularning har birini alohida ijrochiga
  /// yo'naltirish bitta muammoni YIGIRMA marta ishlashga majbur
  /// qilardi — va yigirmasiga alohida javob yozish kerak bo'lardi.
  ///
  /// ⚠️ MUROJAAT O'CHIRILMAYDI VA BIRLASHTIRILMAYDI: har fuqaro
  /// o'z murojaatini va unga javobni KO'RISHI kerak (ilovada
  /// "murojaatlarim" ro'yxati — uning haqqi). Faqat BOG'LANADI:
  /// asosiysi yopilganda bolalari ham birga yopiladi va javob
  /// HAMMASIGA ketadi.
  ///
  /// ⚠️ O'Z-O'ZIGA HAVOLA: asosiy murojaatda `null`, takroriyda —
  /// asosiysining id'si. Alohida "hodisa" jadvali ochilsa, bitta
  /// murojaatli oddiy holat uchun ham bo'sh hodisa yozuvi
  /// yaratilardi.
  duplicateOfId String? @map("duplicate_of_id")

  /// ── SHUBHALI MUROJAAT ───────────────────────────────
  ///
  /// ⚠️ O'CHIRILMAYDI, BELGILANADI. Haqiqiy holatda murojaat matni
  /// fuqaroning O'Z ISMI bo'lgan, ilova esa tasodifiy rasm — ya'ni
  /// odam tizimni sinab ko'rgan. Bunday yozuvni RAD ETISH xodimning
  /// ishi; tizim faqat uni AJRATIB ko'rsatadi.
  ///
  /// ⚠️ AVTOMATIK RAD ETILMAYDI: "mazmunsiz" degan qaror xato
  /// bo'lsa, haqiqiy muammo jimgina yo'qolardi — va buni hech kim
  /// sezmasdi (fuqaro "yuborildi" degan xabarni olgan bo'lardi).
  isSuspicious    Boolean @default(false) @map("is_suspicious")
  suspicionReason String? @map("suspicion_reason")

  /// Yopilganda — kim, qachon va QANDAY hal qildi. `resolution`
  /// botdagi muallifga javob sifatida ketadi.
  resolution String?
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category     IssueCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  duplicateOf  Issue?            @relation("IssueDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates   Issue[]           @relation("IssueDuplicates")
  mahalla      Mahalla?          @relation(fields: [mahallaId], references: [id], onDelete: SetNull)
  author       User?             @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  citizen      Citizen?          @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  assignee     User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer     User?             @relation("IssueReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  orgDoneUser  User?             @relation("IssueOrgDoneBy", fields: [orgDoneBy], references: [id], onDelete: SetNull)
  comments     IssueComment[]
  attachments  IssueAttachment[]
  signal       GroupSignal?

  @@index([status, createdAt(sort: Desc)])
  @@index([mahallaId, status])
  @@index([categoryId, status])
  @@index([assigneeId, status])
  @@index([citizenId, createdAt(sort: Desc)])
  /// ⚠️ Asosiy murojaatning takroriylarini topish uchun.
  @@index([duplicateOfId])
  /// ⚠️ Panel "shubhali" filtri — indekssiz butun jadval
  /// skanerlanardi.
  @@index([isSuspicious, createdAt(sort: Desc)])
  /// ⚠️ TASHKILOT XODIMINING RO'YXATI — uning qamrovi aynan shu
  /// ustun (`issueScopeWhere`). Indekssiz har kirishda butun
  /// `issues` jadvali skanerlanardi.
  @@index([organizationId, status])
  @@map("issues")
}

/// MUROJAAT FAYLI — fuqaro yuborgan surat/video.
///
/// ⚠️ APPEND-ONLY: murojaat bilan BIRGAGINA o'chadi (`onDelete: Cascade`).
/// Fuqaro "chiqindi uyumi" deb surat yuborgan, keyin surat yo'qolsa,
/// murojaatning asosi qolmaydi — dalil, bezak emas.
///
/// ⚠️ FAYL DISKDA, bazada emas. `path` — diskdagi `randomUUID` nomi;
/// asl nom (`originalName`) yo'l sifatida ISHLATILMAYDI (`../../.env`
/// hujumi). Tur FAYL ICHIDAN aniqlangan (`uploads.service.ts`),
/// `Content-Type` dan emas.
model IssueAttachment {
  id String @id @default(cuid())

  issueId String @map("issue_id")

  /// Baytlardan aniqlangan tur.
  kind IssueAttachmentKind

  /// Diskdagi nom (`randomUUID` + kengaytma), `/uploads/` ostida.
  path String

  /// Haqiqiy MIME (baytdan aniqlangan).
  mimeType String @map("mime_type")
  size     Int

  /// Fuqaro qurilmasidagi asl nom — faqat ma'lumot uchun saqlanadi,
  /// hech qachon yo'l sifatida ishlatilmaydi.
  originalName String? @map("original_name")

  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("issue_attachments")
}

enum IssueAttachmentKind {
  photo
  video
}

/// MUAMMO YOZISHMASI — ichki izohlar.
///
/// ⚠️ APPEND-ONLY: izoh tahrirlanmaydi ham, o'chirilmaydi ham. Bu
/// muammo bo'yicha qaror tarixi va uni qayta yozish mumkin emas. Xato
/// yozilsa — yangi izoh qo'shiladi.
model IssueComment {
  id String @id @default(cuid())

  issueId String @map("issue_id")

  /// ⚠️ XODIM YOZSA `userId`, FUQARO YOZSA `citizenId` — IKKISIDAN BIRI.
  /// Ikkisi ham `null` bo'lmasligi kerak (amaliy qoida; schema darajasida
  /// majburlanmaydi). Fuqaro izohi ("qo'shimcha") ham ro'yxatga tushadi
  /// va ma'muriyatга ko'rinadi.
  userId    String? @map("user_id")
  citizenId String? @map("citizen_id")

  body String

  /// ⚠️ `true` bo'lsa izoh MUALLIFGA (bot/fuqaroga) ham ketadi. Standart
  /// `false`: ichki muhokama tashqariga chiqmasligi kerak. Fuqaroning
  /// o'z izohi esa `true` bilan yoziladi.
  isPublic Boolean @default(false) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")

  issue   Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  citizen Citizen? @relation(fields: [citizenId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@map("issue_comments")
}

// ══════════════════════════════════════════════════════════════════════
//  SOZLAMALAR VA AUDIT
// ══════════════════════════════════════════════════════════════════════

/// TIZIM SOZLAMALARI — SINGLETON.
///
/// ⚠️ BITTA QATOR: `id` har doim `"singleton"`. Alohida `key/value`
/// jadvali emas, chunki sozlamalar soni oz va ularning TURI muhim (son,
/// bayroq, satr) — `value String` bo'lsa har o'qishda parse va tekshiruv
/// kerak bo'lardi.
model Settings {
  id String @id @default("singleton")

  /// Viloyat/tashkilot nomi — hisobot sarlavhasida.
  orgName String @default("E Murojaat") @map("org_name")

  /// VILOYAT CHEGARASI — xaritaning TAYANCHI.
  ///
  /// {W} ALOHIDA JADVALDA EMAS: tizim BITTA viloyat uchun ishlaydi
  /// va jadval ochilsa, unda abadiy bitta qator yotardi — ustiga
  /// "qaysi viloyat joriy" degan savol qo'shilardi.
  ///
  /// {W} TUMANLAR YIG'INDISIDAN HISOBLANMAYDI: poligonlarni
  /// birlashtirish (union) kutubxona talab qiladi va natijada
  /// qo'shni tumanlar orasida yupqa "tirqish"lar qolardi — chegara
  /// chizig'i esa aynan tashqi kontur bo'lishi kerak.
  provinceGeoJson Json? @map("province_geo_json")

  /// ── AI TAHLILI ──────────────────────────────────────────────────
  ///
  /// ⚠️ MODEL NOMI BU YERDA YO'Q. U KODDA
  /// (`signals/ai/signal-ai.constants.ts`): model almashtirish kod
  /// o'zgarishi va review'dan o'tishi kerak, tasodifiy sozlama tahriri
  /// emas. Bu yerda faqat YOQISH/O'CHIRISH va chegaralar.
  aiEnabled Boolean @default(true) @map("ai_enabled")

  /// Tahlil qancha vaqtda bir ishlaydi (daqiqa).
  ///
  /// ⚠️ CRON IFODASI QOTIB QOLMASLIGI UCHUN bazadan o'qiladi: job har
  /// daqiqada ishga tushadi va "vaqti keldimi" deb O'ZI tekshiradi
  /// (`signals.job.ts`). Cron ifodasini kodga yozib qo'ysak, uni
  /// o'zgartirish uchun deploy kerak bo'lardi.
  aiIntervalMinutes Int @default(30) @map("ai_interval_minutes")

  /// Bitta aylanishda ko'riladigan eng ko'p xabar.
  ///
  /// ⚠️ CHEGARA JOB'NI PREDSKAZUEMY QILADI: bot bir kecha ishlab,
  /// ertalab server ko'tarilsa minglab xabar yig'ilgan bo'lishi mumkin.
  /// Hammasi bitta aylanishda AI'ga ketsa — hisob ham, vaqt ham
  /// portlardi. Qolgani keyingi aylanishda ko'riladi.
  aiMaxMessagesPerRun Int @default(300) @map("ai_max_messages_per_run")

  /// Tahlil qilingan xabar qancha turib o'chiriladi (soat).
  messageRetentionHours Int @default(24) @map("message_retention_hours")

  /// ── BILDIRISHNOMA ───────────────────────────────────────────────
  ///
  /// Yuqori jiddiylikdagi signal chiqsa — shu chatlarga xabar. Bo'sh
  /// massiv = o'chirilgan.
  alertChatIds     String[]       @default([]) @map("alert_chat_ids")
  /// Qaysi darajadan boshlab xabar ketadi.
  alertMinSeverity SignalSeverity @default(high) @map("alert_min_severity")

  /// ── XAVFSIZLIK QALQONI ──────────────────────────────────────────
  ///
  /// ⚠️ BU YERDA FAQAT "NIMANI ZARARLI DEYISH" sozlanadi, qalqon
  /// YOQILISHI esa har guruhda alohida (`TelegramGroup.guardEnabled`).
  /// Bitta global tugma bilan hamma guruhda o'chirish boshlanishi
  /// mumkin emas — o'chirish qaytarib bo'lmaydigan amal.
  guardDeleteFiles Boolean @default(true) @map("guard_delete_files")
  guardDeleteUrls  Boolean @default(true) @map("guard_delete_urls")

  /// ⚠️ QORA RO'YXAT SOZLAMADA, KODDA EMAS: yangi firibgar domen
  /// har kuni paydo bo'ladi va uni qo'shish uchun deploy kutib
  /// bo'lmaydi. Model nomidan farqli o'laroq, bu ro'yxat xulosa
  /// SIFATIGA ta'sir qilmaydi — faqat qamroviga.
  guardBlockedHosts String[] @default([]) @map("guard_blocked_hosts")

  /// ⚠️ OQ RO'YXAT QORA RO'YXATDAN USTUN: rasmiy domenlar
  /// (`gov.uz`, `t.me`) hech qachon o'chirilmasligi kerak — MFY
  /// xodimi rasmiy havola tashlasa, bot uni yo'q qilib qo'ymasin.
  guardAllowedHosts String[] @default([]) @map("guard_allowed_hosts")

  /// ── MINI APP (FUQARO MUROJAATLARI) ──────────────────────────────
  ///
  /// ⚠️ CHEGARA — BLOK EMAS. Kunlik murojaat soni limiti xato
  /// ishlatayotgan odamni SEKINLATADI (`0` = cheksiz). `Citizen.isBlocked`
  /// esa butunlay yopadi — bu alohida, qattiqroq chora. Chegara sababi
  /// fuqaroga ko'rsatiladi.
  mobileDailyLimit Int @default(0) @map("mobile_daily_limit")

  /// Bitta murojaatga biriktiriladigan eng ko'p fayl.
  mobileMaxAttachments Int @default(5) @map("mobile_max_attachments")

  /// ── TELEFON MAJBURIYMI ──────────────────────────────────────────
  ///
  /// ⚠️ STANDART — `true` VA BU ATAYLAB. Telefonsiz murojaatda xodim
  /// odamga bog'lana olmaydi: Telegram ismi "ALHAMDULILLAX 🙌🙌" bo'lishi
  /// mumkin, hudud esa "Belgilanmagan". Bunday murojaat navbatda
  /// turadi-yu, hal qilib bo'lmaydi — aniq shu holat kuzatilgan.
  ///
  /// ⚠️ O'CHIRISH IMKONI QOLDIRILGAN, chunki talab O'ZGARUVCHAN:
  /// raqam so'ralishi murojaat yuborishni sekinlashtiradi va
  /// ma'muriyat uni vaqtincha yumshatishni xohlashi mumkin. Lekin
  /// qiymat SOZLAMADA, kodda emas — o'zgartirish uchun deploy kerak
  /// bo'lmasligi uchun.
  ///
  /// ⚠️ TEKSHIRUV MUROJAAT YARATISHDA, KIRISHDA EMAS: odam botni
  /// ochib, ro'yxatni ko'rib, yangilik o'qishi mumkin — raqam faqat
  /// MUROJAAT yozmoqchi bo'lganda so'raladi.
  requirePhone Boolean @default(true) @map("require_phone")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

/// AUDIT — kim nima qildi.
///
/// ⚠️ FAQAT MUHIM AMALLAR yoziladi, har so'rov emas: login, ruxsat
/// o'zgarishi, guruhni rasmiy qilish, signalni biriktirish/yopish,
/// muammo holati. "Hamma narsani yozish" jurnalni o'qib bo'lmaydigan
/// qilardi va u o'shandan keyin hech kimga kerak bo'lmasdi.
model AuditLog {
  id String @id @default(cuid())

  userId   String? @map("user_id")
  /// "auth.login", "group.official", "signal.attach", "issue.resolve"
  action   String
  /// Qaysi obyekt ustida.
  entity   String?
  entityId String? @map("entity_id")

  /// Qo'shimcha kontekst (eski/yangi qiymat).
  meta Json?

  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════
//  XAVFSIZLIK — guruhga tashlangan zararli fayl va havolalar
// ═══════════════════════════════════════════════════════════════════

/// Nima aniqlangani.
///
/// ⚠️ TUR SAQLANADI, chunki ular BOSHQACHA ko'riladi: APK — qasddan
/// tarqatilgan dastur, qisqartirilgan havola esa ko'pincha oddiy
/// odamning e'loni. Ikkisini bitta "shubhali" qopiga solish
/// hisobotni ma'nosiz qilardi.
enum ThreatKind {
  /// Telegram orqali tashlangan o'rnatma fayl (apk, exe, msi...).
  apk_file
  /// Umuman ruxsat etilmagan turdagi hujjat.
  unknown_file
  /// Qora ro'yxatdagi yoki shubhali domen.
  suspicious_url
  /// Havolani yashiradigan qisqartirgich (bit.ly va o'xshashlari).
  shortened_url
  /// Matn ichida ko'rinadigan havola HAQIQIY manzildan farq qiladi.
  masked_url
  /// Firibgarlik matni: "davlat yordami" aldovi + ishonchsiz havola.
  scam_text
}

/// Bot nima qila oldi.
///
/// ⚠️ "ANIQLANDI" VA "O'CHIRILDI" ALOHIDA: bot admin bo'lmasa
/// o'chira OLMAYDI (Telegram ruxsat bermaydi) va bu holat panelda
/// KO'RINISHI kerak — aks holda ma'muriyat "tizim ishlayapti" deb
/// o'ylab, zararli fayl guruhda qolib ketardi.
enum ThreatAction {
  /// O'chirildi.
  deleted
  /// Aniqlandi, lekin o'chirilmadi (botda huquq yo'q yoki muddati o'tgan).
  detected
  /// O'chirishga urinildi va Telegram rad etdi.
  delete_failed
}

/// XAVFSIZLIK HODISASI — guruhda aniqlangan zararli kontent.
///
/// ⚠️ BU `GroupSignal` EMAS. Signal — AI TAXMINI va u odam qaroriga
/// muhtoj. Bu yerda esa qoida QAT'IY ("apk = zararli") va bot
/// darhol harakat qiladi. Ikkisini bitta jadvalga qo'shish
/// "signallar — taxmin" degan doktrinani buzardi.
///
/// ⚠️ YOZUV APPEND-ONLY: o'chirilmaydi va tahrirlanmaydi. Bu —
/// xavfsizlik dalili va kimdir uni "tozalab" qo'ya olmasligi kerak.
model SecurityEvent {
  id String @id @default(cuid())

  chatId    String  @map("chat_id")
  /// ⚠️ `String?`: xabar o'chirilgach Telegram'da u yo'q, lekin
  /// raqami dalil sifatida qoladi.
  messageId String? @map("message_id")

  kind   ThreatKind
  action ThreatAction

  /// ── KIM TASHLADI (muhrlangan) ───────────────────────────────────
  ///
  /// ⚠️ NUSXA OLINADI, jonli o'qilmaydi: odam guruhdan chiqib
  /// ketsa ham "kim tashlagani" hisobotda qolishi kerak.
  senderTgId     String? @map("sender_tg_id")
  senderName     String? @map("sender_name")
  senderUsername String? @map("sender_username")

  /// ── FAYL HAQIDA ─────────────────────────────────────────────────
  fileName     String? @map("file_name")
  /// Telegram aytgan MIME turi — ISHONCHSIZ (yuboruvchi o'zgartira
  /// oladi), shuning uchun kengaytma ALOHIDA saqlanadi.
  fileMime     String? @map("file_mime")
  fileSize     Int?    @map("file_size")
  /// Telegram `file_unique_id` — AYNI fayl boshqa guruhda ham
  /// tashlanganini topish uchun.
  fileUniqueId String? @map("file_unique_id")

  /// ── HAVOLA HAQIDA ───────────────────────────────────────────────
  /// Aniqlangan havola (to'liq).
  url     String?
  /// Faqat domen — hisobotda guruhlash shu bo'yicha.
  urlHost String? @map("url_host")

  /// Nima uchun zararli deb topilgani (qoida kaliti).
  reason String

  /// Xabar matni — dalil sifatida (kesilgan).
  ///
  /// ⚠️ SAQLANADI, chunki xabar O'CHIRILADI va undan keyin
  /// ma'muriyat nima yozilganini KO'RA OLMAYDI.
  messageText String? @map("message_text")

  /// Telegram rad etgan bo'lsa — sababi.
  errorMessage String? @map("error_message")

  /// ── KO'RIB CHIQILDI (noto'g'ri o'chirish) ─────────────────
  ///
  /// ⚠️ DALIL O'ZGARMAYDI. `security_events` append-only bo'lib
  /// qoladi: matn, havola, sabab va amal HECH QACHON tahrirlanmaydi.
  /// Bu maydonlar — DALILNING O'ZI emas, uning ustidan chiqarilgan
  /// ODAM XULOSASI ("bu havola zararli emas edi").
  ///
  /// ⚠️ KERAK, CHUNKI QALQON XATO QILADI: qoida qat'iy, lekin
  /// dunyodagi hamma holatni qamray olmaydi. Noto'g'ri o'chirish
  /// belgilanmasa, u hisobotda "aniqlangan tahdid" bo'lib sanalib,
  /// qalqonning haqiqiy foydasini yashirardi.
  isFalsePositive Boolean   @default(false) @map("is_false_positive")
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  group TelegramGroup @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  /// ⚠️ Bir xabar ikki marta kelishi mumkin (bot qayta ishga tushdi,
  /// Telegram takrorladi) — dublikat yozuv hisobotni shishirardi.
  @@unique([chatId, messageId])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([senderTgId])
  @@map("security_events")
}

// ══════════════════════════════════════════════════════════════════════
//  FUQARO (MINI APP) — XODIMDAN BUTUNLAY ALOHIDA
// ══════════════════════════════════════════════════════════════════════

/// FUQARO — Mini App orqali murojaat yuboradigan oddiy aholi.
///
/// ⚠️ `User` EMAS. `users` — tizim XODIMLARI: parol, ruxsat ro'yxati,
/// hududiy qamrov, panelga kirish. Fuqaroda bularning HECH BIRI yo'q.
/// Ikkisini bitta jadvalga qo'shish `permissions` ustunini butun
/// aholiga tarqatardi — bitta xato standart qiymat o'nlab ming odamga
/// panel ochib qo'yardi.
///
/// ⚠️ FUQARO TOKENI UCHINCHI ALOHIDA SIR bilan imzolanadi
/// (`MOBILE_JWT_SECRET`): `typ` tekshiruvi tushib qolsa ham fuqaro
/// tokeni panelga kira olmaydi.
model Citizen {
  id String @id @default(cuid())

  /// ── FUQARO IKKI YO'L BILAN KIRADI ───────────────────────────────
  ///
  /// ⚠️ IKKI ILOVA, IKKI KIRISH: `mini-app` (Telegram ichidagi
  /// mini-ilova) `initData` bilan kiradi va `telegramId` oladi;
  /// `mobile` (Flutter, Play Market / App Store) Google bilan
  /// kiradi va `googleId` oladi. Shuning uchun IKKALASI HAM
  /// IXTIYORIY, lekin fuqaroda KAMIDA BITTASI bo'ladi
  /// (`mobile-auth.service.ts` boshqa yo'l bilan yozmaydi).
  ///
  /// ⚠️ IKKISI BIR USTUNGA BIRLASHTIRILMAYDI: `telegramId` ayni
  /// vaqtda JAVOB MANZILI ham (bot shu chatga yozadi). Umumiy
  /// "externalId" bo'lsa, bot Google hisob raqamiga yozishga
  /// urinardi va xato faqat ish vaqtida chiqardi.

  /// Telegram foydalanuvchi id'si — mini-ilovadan kirganda. Javob SHU
  /// chatga boradi (shaxsiy chat). Google bilan kirganda — `null`.
  telegramId String? @unique @map("telegram_id")

  /// Google hisobining doimiy id'si (`sub`) — mobil ilovadan kirganda.
  ///
  /// ⚠️ POCHTA EMAS, `sub` BO'YICHA TOPILADI: pochtani egasi
  /// o'zgartirishi mumkin va o'shanda fuqaro hisobidan ajralib,
  /// murojaatlari tarixi YO'QOLARDI. `sub` esa o'zgarmaydi.
  googleId String? @unique @map("google_id")

  /// Apple hisobining doimiy id'si (`sub`) — mobil ilovadan iOS'da
  /// "Sign in with Apple" bilan kirganda.
  ///
  /// ⚠️ NEGA ALOHIDA USTUN — `googleId` GA QO'SHILMAYDI: App Store
  /// qoidasi (4.8) iOS'da Google yonida maxfiylikni himoya qiluvchi
  /// muqobil kirish talab qiladi va Apple aynan shu. U — UCHINCHI
  /// kirish yo'li va "Uch kirish yo'li — bitta fuqaro" doktrinasiga
  /// ko'ra ALOHIDA fuqaro bo'ladi: Apple pochtani yashirishi mumkin
  /// (`privaterelay.appleid.com`), ya'ni Google bilan birlashtiradigan
  /// ishonchli belgi YO'Q. Umumiy "externalId" bo'lsa, Apple `sub`
  /// Google `sub` bilan to'qnashib, begona murojaatlar tarixi ochilib
  /// ketardi.
  ///
  /// ⚠️ POCHTA EMAS, `sub` BO'YICHA TOPILADI (Google bilan ayni sabab).
  appleId String? @unique @map("apple_id")

  /// Apple `refresh_token` — SHIFRLANGAN holda (`common/secret-box.ts`).
  ///
  /// ⚠️ NIMA UCHUN SAQLANADI: App Store qoidasi 5.1.1(v) hisobni
  /// o'chirishda Apple RUXSATINI HAM bekor qilishni talab qiladi
  /// (`/auth/revoke`). O'sha chaqiruv token talab qiladi va uni FAQAT
  /// kirish paytida olish mumkin (`authorizationCode` bir martalik,
  /// bir necha daqiqada so'nadi) — ya'ni o'chirish vaqtida qayta olib
  /// bo'lmaydi. Saqlanmasa, revoke umuman imkonsiz bo'lardi.
  ///
  /// ⚠️ SHIFRLANGAN: bu TIRIK ruxsat — o'qigan odam fuqaro nomidan
  /// Apple'dan yangi `id_token` olishi mumkin. Bazaga xom yozilsa,
  /// zaxira nusxasi (dump) tarqalganda har bir iOS fuqaroning hisobi
  /// ochilib ketardi. Kalit — `MOBILE_JWT_SECRET` dan (`signed-ref.ts`
  /// bilan ayni mantiq: kontekst bilan ajratilgan).
  ///
  /// ⚠️ PANELGA HECH QACHON CHIQMAYDI va `select` ro'yxatlariga
  /// qo'shilmaydi — faqat `mobile-auth` yozadi, faqat o'chirish
  /// o'qiydi.
  appleRefreshToken String? @map("apple_refresh_token")

  /// ── HISOBNI O'CHIRISH (App Store 5.1.1(v), Google Play) ─────────
  ///
  /// O'chirilgan vaqt. `null` — hisob FAOL.
  ///
  /// ⚠️ QATOR O'CHIRILMAYDI, FAQAT BELGILANADI. Sabab: murojaatlar
  /// (`Issue`) va izohlar HISOBOT uchun QOLADI — "mart oyida nechta
  /// murojaat keldi" degan raqam odam hisobini o'chirgani uchun
  /// o'zgarib ketmasligi kerak (`Issue.source` muhrlangan qiymat
  /// bo'lgani bilan ayni sabab). Qator o'chirilsa, `citizenId` bo'sh
  /// qolib murojaat "egasiz" bo'lardi yoki kaskad bilan murojaatlar
  /// ham ketardi.
  ///
  /// ⚠️ SHAXSIY MA'LUMOT ESA TOZALANADI (`mobile.service.ts#deleteMe`):
  /// ism, familiya, username, rasm, pochta, telefon, hudud va UCHALA
  /// kirish kaliti (`telegramId`/`googleId`/`appleId`) `null` bo'ladi.
  /// Ya'ni qator qoladi, ORTIDAGI ODAM esa qolmaydi.
  ///
  /// ⚠️ KALITLAR TOZALANGANI UCHUN qayta kirish YANGI fuqaro yaratadi:
  /// eskisiga ulanmaydi. Bu ataylab — "o'chirdim" degan odam qayta
  /// kirganda eski murojaatlari qaytib kelsa, o'chirish ishonchini
  /// yo'qotardi.
  deletedAt DateTime? @map("deleted_at")

  /// Google/Apple hisobidagi pochta — faqat KO'RSATISH uchun (panelda
  /// fuqaroni tanib olish). Kirish bo'yicha kalit EMAS.
  ///
  /// ⚠️ APPLE "yashirish" tanlasa, bu yerga xususiy relay manzili
  /// (`...@privaterelay.appleid.com`) tushadi — bu NORMAL, xato emas.
  email String?

  /// ── TELEGRAM / GOOGLE'DAN (har kirishda yangilanadi) ────────────
  firstName String  @map("first_name")
  lastName  String? @map("last_name")
  username  String?
  photoUrl  String? @map("photo_url")

  languageCode String @default("uz") @map("language_code")

  /// ── FUQARONING O'ZI KIRITADIGAN ─────────────────────────────────
  phone String?

  /// Hudud — murojaatni to'g'ri MFY ga yo'naltirish va yangiliklarni
  /// filtrlash uchun. Majburiy emas.
  districtId String? @map("district_id")
  mahallaId  String? @map("mahalla_id")

  /// Faollik bali — reyting shundan (`common/points.ts` yagona manba).
  points Int @default(0)

  /// ── OXIRGI FAOLLIK ────────────────────────────────────────────
  ///
  /// ⚠️ "RO'YXATDAN O'TGAN" VA "FAOL" — BOSHQA-BOSHQA SON. Botni bir
  /// marta ochib tashlab ketgan odam `citizens` da abadiy qoladi va
  /// panelda "obunachilar" soni yildan-yilga o'sib, MA'NOSINI
  /// yo'qotardi. Shu maydon "oxirgi 30 kunda nechta odam ishlatdi"
  /// degan HAQIQIY savolga javob beradi.
  ///
  /// ⚠️ HAR SO'ROVDA EMAS, KUNIGA BIR MARTA yangilanadi
  /// (`bot-citizens.service.ts`): har tugma bosilishida `UPDATE`
  /// yozish bazani keraksiz band qilardi.
  lastSeenAt DateTime? @map("last_seen_at")

  /// ⚠️ BLOK — CHEGARADAN QATTIQROQ CHORA. Butunlay yopadi. Shuning
  /// uchun `citizens.manage` ruxsati operatorga BERILMAYDI. Sabab
  /// MAJBURIY — fuqaroga ilovada ko'rsatiladi.
  isBlocked   Boolean @default(false) @map("is_blocked")
  blockReason String? @map("block_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  mahalla  Mahalla?       @relation(fields: [mahallaId], references: [id], onDelete: SetNull)
  issues   Issue[]
  comments IssueComment[]

  @@index([points(sort: Desc)])
  @@index([districtId])
  /// ⚠️ REYTING VA RO'YXATLAR `deletedAt: null` BO'YICHA FILTRLANADI —
  /// indekssiz u butun jadvalni skanerlab o'tardi.
  @@index([deletedAt])
  /// ⚠️ "Oxirgi 30 kunda faol" sanog'i uchun — panel sarlavhasida
  /// har ochilishda hisoblanadi.
  @@index([lastSeenAt])
  @@map("citizens")
}

/// YANGILIK / E'LON — ilovadagi "Yangiliklar" ro'yxati.
///
/// ⚠️ TUMAN BO'YICHA FILTRLANADI: `districtId` null bo'lsa — butun
/// viloyat uchun; aks holda faqat shu tuman fuqarolariga ko'rinadi.
model Announcement {
  id String @id @default(cuid())

  title String
  body  String

  /// Muqova surati — `/uploads/` ostidagi yo'l (ixtiyoriy).
  coverPath String? @map("cover_path")

  /// Yuqoriga qadab qo'yilgan e'lon ro'yxat boshida turadi.
  isPinned Boolean @default(false) @map("is_pinned")

  /// null = butun viloyat bo'yicha.
  districtId String? @map("district_id")

  /// `null` — qoralama (ilovada ko'rinmaydi). To'ldirilsa — nashr etilgan.
  publishedAt DateTime? @map("published_at")

  /// ── REJALI NASHR ───────────────────────────────────
  ///
  /// ⚠️ `publishedAt` BILAN ARALASHTIRILMAYDI: biri — "qachon nashr
  /// etilgan" (o'tmish, ro'yxat tartibi shundan), ikkinchisi —
  /// "qachon nashr etilsin" (kelajak). Bitta maydonga sig'dirilsa,
  /// kelajakdagi sana bilan yozuv ilovada ALLAQACHON nashr etilgandek
  /// ko'rinardi.
  ///
  /// ⚠️ VAQTI KELGANDA CRON NASHR ETADI va `scheduledAt` TOZALANADI
  /// — aks holda tahrirlangan e'lon qayta nashr etilib, ro'yxat
  /// boshiga chiqib ketardi.
  scheduledAt DateTime? @map("scheduled_at")

  /// Ko'rish sanog'i — ko'rsatkich, hisobot emas ("ot va unut").
  viewCount Int @default(0) @map("view_count")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District?           @relation(fields: [districtId], references: [id], onDelete: SetNull)
  media    AnnouncementMedia[]

  @@index([publishedAt(sort: Desc)])
  @@index([districtId, publishedAt(sort: Desc)])
  /// ⚠️ Cron har daqiqada "vaqti kelganlarini" so'raydi — indekssiz
  /// u butun jadvalni skanerlab o'tardi.
  @@index([scheduledAt])
  @@map("announcements")
}

// ══════════════════════════════════════════════════════════════════════
//  IJROCHI QOIDASI — MFY × YO'NALISH → XODIM
// ══════════════════════════════════════════════════════════════════════

/// AVTOMATIK IJROCHI BIRIKTIRISH QOIDASI.
///
/// ── NIMA UCHUN ALOHIDA JADVAL ───────────────────────────────────────
///
/// ⚠️ QOIDA `Issue` DA SAQLANMAYDI va saqlanishi ham mumkin emas:
/// murojaat yaratilayotganda ijrochi hali NOMA'LUM — aynan shu jadval
/// uni aytib beradi. Teskarisi ham to'g'ri: qoida keyin
/// o'zgartirilsa, ALLAQACHON yaratilgan murojaatning ijrochisi
/// O'ZGARMAYDI (`Issue.assigneeId` — nusxa, jonli havola emas).
/// Bo'lmasa, o'tgan oy kim ishlaganini bilib bo'lmay qolardi.
///
/// ⚠️ KALIT — MFY VA YO'NALISH BIRGALIKDA. "Chilonzor 12-MFY dagi
/// suv muammosi — Aliyev" degan qoida shu ikki ustunda turadi.
/// Faqat MFY bo'yicha qoida bo'lsa, bitta odamga MFY ning HAMMA
/// muammosi tushardi; faqat yo'nalish bo'yicha bo'lsa, viloyatdagi
/// barcha suv muammosi bitta xodimga ketardi.
///
/// ⚠️ BITTA JUFTLIKKA BITTA IJROCHI (`@@unique`): ikkitasi bo'lsa
/// "qaysi biri" degan savol har murojaatda TASODIFIY hal bo'lardi.
/// Bitta xodim bir nechta yo'nalishga biriktirilishi esa mumkin —
/// bu oddiy holat (har qatorga bitta yo'nalish).
model MahallaAssignee {
  id String @id @default(cuid())

  mahallaId  String @map("mahalla_id")
  categoryId String @map("category_id")

  /// ⚠️ XODIM, FUQARO EMAS: ijrochi panelga kiradigan `User`.
  /// `Citizen` ga biriktirish murojaatni aholi qo'liga berardi.
  userId String @map("user_id")

  /// ⚠️ IXTIYORIY MUDDAT: berilgan bo'lsa, murojaatning `dueAt` i
  /// yo'nalishning umumiy SLA'si o'rniga shundan hisoblanadi — bir
  /// MFY da suv muammosi tezroq hal bo'lishi mumkin.
  slaHours Int? @map("sla_hours")

  isActive Boolean @default(true) @map("is_active")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mahalla  Mahalla       @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  category IssueCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User          @relation("AssignmentRuleUser", fields: [userId], references: [id], onDelete: Cascade)
  author   User?         @relation("AssignmentRuleAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([mahallaId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("mahalla_assignees")
}

// ══════════════════════════════════════════════════════════════════════
//  TARQATMA — PANELDAN VA BOTDAN YUBORILADIGAN XABAR
// ══════════════════════════════════════════════════════════════════════

/// Tarqatma KIMGA ketadi.
///
/// ⚠️ `citizens` — SHAXSIY chat (botga yozgan odamlar), `groups` — MFY
/// GURUHLARI. Ikkisi butunlay boshqa auditoriya va ularni bitta
/// qiymatga birlashtirish "e'lonni guruhga yubordim, lekin odamlar
/// ko'rmadi" degan holatni yashirardi.
enum BroadcastAudience {
  citizens
  groups
  both
}

/// Xabar QANDAY ketadi.
///
/// ⚠️ UCHTASI HAM KERAK va ular mijoz talabidan kelib chiqadi:
///   text    — panelda yozilgan matn
///   forward — botga tashlangan xabar "Forwarded from" bilan
///   copy    — AYNI xabar, lekin manbasiz ("asl holatda")
///
/// ⚠️ `forward` VA `copy` FARQI KO'RINADIGAN: forward manbani
/// ko'rsatadi (kanal nomi), copy esa botning o'z xabari bo'lib
/// ko'rinadi. Qaysi biri kerakligi — yuboruvchining qarori.
enum BroadcastMode {
  text
  forward
  copy
}

/// ⚠️ `pending → sending → done/failed`. Oraliq holat KERAK: tarqatma
/// minglab xabar bo'lishi mumkin va u FON'DA ketadi — HTTP so'rovi
/// uni kutib turolmaydi (timeout). Panel holatni so'rab turadi.
enum BroadcastStatus {
  pending
  sending
  done
  failed
}

/// TARQATMA YOZUVI — DALIL VA HOLAT.
///
/// ⚠️ YOZUV MAJBURIY: tarqatma — qaytarib bo'lmaydigan amal (yuborilgan
/// xabarni o'qilmagan qilib bo'lmaydi). "Kim, qachon, kimga, nima
/// yubordi" savoliga javob shu jadvalda. `AuditLog` ga faqat fakt
/// yoziladi, matn esa bu yerda turadi.
///
/// ⚠️ APPEND-ONLY: tahrirlanmaydi. Yuborilgan xabar matnini keyin
/// o'zgartirish dalilni soxtalashtirardi.
model Broadcast {
  id String @id @default(cuid())

  audience BroadcastAudience
  mode     BroadcastMode

  /// `mode: text` uchun — yuborilgan matn.
  text String?

  /// ── FORWARD / COPY MANBASI ──────────────────────────────────────
  ///
  /// ⚠️ MANBA — ADMINNING SHAXSIY CHATI: u xabarni botga tashlaydi va
  /// Telegram `forwardMessage`/`copyMessage` uchun aynan shu
  /// (`from_chat_id`, `message_id`) juftligini talab qiladi. Baytlar
  /// ko'chirilmaydi — Telegram xabarni O'ZI nusxalaydi.
  ///
  /// ⚠️ MANBA XABARI O'CHIRILSA TARQATMA ISHLAMAY QOLADI va bu
  /// TUZATIB BO'LMAYDIGAN holat: shuning uchun yuborish darhol
  /// boshlanadi, navbatda uzoq turmaydi.
  fromChatId      String? @map("from_chat_id")
  sourceMessageId String? @map("source_message_id")

  /// ── QAMROV ──────────────────────────────────────────────────────
  ///
  /// ⚠️ IKKALASI HAM `null` — BUTUN VILOYAT. Bu eng kuchli amal va
  /// shuning uchun u alohida ruxsat talab qiladi (`broadcast.send`).
  districtId String? @map("district_id")
  mahallaId  String? @map("mahalla_id")

  status BroadcastStatus @default(pending)

  /// ⚠️ UCHTA SON: `total` — topilgan manzil, `sent` — yetib borgani,
  /// `failed` — rad etilgani (odam botni bloklagan). Ikkinchisi
  /// birinchisiga TENG BO'LMASLIGI normal holat.
  total  Int @default(0)
  sent   Int @default(0)
  failed Int @default(0)

  /// Butun tarqatma yiqilgan bo'lsa — sabab.
  error String?

  /// ⚠️ KIM YUBORGANI — `User`, ya'ni XODIM. Botdan yuborilganda ham
  /// shu: admin `User.telegramId` bo'yicha topiladi.
  createdBy String @map("created_by")

  /// `panel` yoki `bot` — qaysi yo'ldan yuborilgani.
  via String @default("panel")

  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  author   User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  mahalla  Mahalla?  @relation(fields: [mahallaId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("broadcasts")
}

// ══════════════════════════════════════════════════════════════════════
//  TAHDID RO'YXATLARI — TASHQI, O'ZI YANGILANADIGAN MANBALAR
// ══════════════════════════════════════════════════════════════════════

/// Ro'yxat fayli qanday o'qiladi.
///
/// ⚠️ TO'RT SHAKL, chunki manbalar bir xil emas:
///   hosts    — `0.0.0.0 evil.com` (AdGuard/StevenBlack uslubi)
///   domains  — har qatorda bitta domen
///   adguard  — `||evil.com^` (AdGuard filtr sintaksisi)
///   urlhaus  — URLhaus CSV (to'liq havola, hostni ajratib olamiz)
///
/// ⚠️ SHAKL AVTOMATIK ANIQLANMAYDI, QO'LDA TANLANADI: manba bir kun
/// formatini o'zgartirsa, avtomatik aniqlash JIMGINA noto'g'ri
/// tahlilga o'tib, ro'yxat bo'shab qolardi — himoya esa o'chgandek
/// bo'lardi.
enum ThreatFeedFormat {
  hosts
  domains
  adguard
  urlhaus
}

/// TASHQI TAHDID RO'YXATI (fishing / zararli domenlar).
///
/// ── NIMA UCHUN KERAK ────────────────────────────────────────────────
///
/// ⚠️ QORA RO'YXAT QO'LDA TO'LDIRILADI va u HAR DOIM KECHIKADI: yangi
/// firibgar domen ertalab paydo bo'lib, kechqurun bloklanardi — oradagi
/// vaqtda aholi havolani bosib ulgurardi. Tashqi ro'yxatlar (URLhaus,
/// PhishTank, AdGuard) esa SOATLAB yangilanadi va ularni o'qish
/// qo'lda kiritishdan ko'ra tezroq.
///
/// ⚠️ QO'LDAGI RO'YXAT O'RNINI BOSMAYDI, QO'SHIMCHA: mahalliy
/// firibgar domenlar (`uzbekistonviplata.xyz`) tashqi ro'yxatlarga
/// umuman tushmaydi. Ikkisi BIRGA ishlaydi.
///
/// ⚠️ OQ RO'YXAT USTUN: `gov.uz` tashqi ro'yxatda xato bilan paydo
/// bo'lsa ham o'chirilmaydi (`inspectUrl` dagi tartib).
model ThreatFeed {
  id String @id @default(cuid())

  name String @unique
  url  String

  format ThreatFeedFormat @default(domains)

  /// ⚠️ O'CHIRILGAN RO'YXAT YANGILANMAYDI, lekin HOSTLARI QOLADI —
  /// qayta yoqilganda qaytadan yuklab o'tirmaslik uchun. Butunlay
  /// olib tashlash — yozuvni o'chirish (hostlari `Cascade` bilan
  /// ketadi).
  isEnabled Boolean @default(true) @map("is_enabled")

  /// QANCHA VAQTDA BIR MARTA YANGILANADI (soat).
  ///
  /// ⚠️ BITTA SON HAMMASIGA TO'G'RI KELMAYDI: OpenPhish 264 domen
  /// beradi va soatlab yangilanadi (bir necha kilobayt), AdGuard esa
  /// 190 000 domen va sekin o'zgaradi. Hammasini tez yangilash
  /// bazaga kuniga millionlab qator yozishni anglatardi; hammasini
  /// sekin yangilash esa eng TIRIK manbani bekorga eskirtirardi.
  ///
  /// ⚠️ STANDART 72 SOAT — EHTIYOTKOR QIYMAT: keyin qo'shiladigan,
  /// hajmi o'ylanmagan manba sekin boshlashi kerak. Tezlatish —
  /// ongli qaror.
  refreshHours Int @default(72) @map("refresh_hours")

  /// ── OXIRGI YANGILANISH ──────────────────────────────────────────
  ///
  /// ⚠️ XATO SAQLANADI: ro'yxat bir hafta yuklanmay turgan bo'lsa,
  /// panel buni KO'RSATISHI kerak — aks holda himoya eskirib
  /// ketganini hech kim sezmasdi.
  lastFetchedAt DateTime? @map("last_fetched_at")
  lastCount     Int       @default(0) @map("last_count")
  lastError     String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hosts ThreatHost[]

  @@map("threat_feeds")
}

/// RO'YXATDAN OLINGAN BITTA HOST.
///
/// ⚠️ `host` BIRLAMCHI KALIT EMAS: bir domen bir necha ro'yxatda
/// bo'lishi mumkin va ikkalasidan ham o'chirilganda yo'qolishi kerak.
/// Shuning uchun kalit — `(feedId, host)` juftligi.
///
/// ⚠️ HOST NORMALLASHTIRILGAN HOLDA SAQLANADI (`normalizeHost`:
/// kichik harf, `www.` yo'q, oxirgi nuqta yo'q) — qidiruv aynan
/// shu shaklda boradi va ikki tomonda ikki xil normallashtirish
/// JIM nomuvofiqlik berardi.
model ThreatHost {
  feedId String @map("feed_id")
  host   String

  createdAt DateTime @default(now()) @map("created_at")

  feed ThreatFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@id([feedId, host])
  /// ⚠️ HOST BO'YICHA INDEKS: botga beriladigan ro'yxat `distinct`
  /// bilan yig'iladi va usiz butun jadval skanerlanardi.
  @@index([host])
  @@map("threat_hosts")
}

/// E'LONGA BIRIKTIRILGAN FAYL (surat/video).
///
/// ── NIMA UCHUN ALOHIDA JADVAL ─────────────────────────────
///
/// ⚠️ ESKI `coverPath` BITTA SURAT EDI va e'lonning asosiy mazmuni
/// ko'pincha RASMDA bo'ladi (jadval, e'lon varaqasi, buzilgan joy
/// surati). Bitta muqova bilan ularning birini tanlab, qolganini
/// tashlab ketish kerak bo'lardi.
///
/// ⚠️ `IssueAttachment` BILAN AYNI MANTIQ, LEKIN ALOHIDA JADVAL:
/// murojaat fayli — DALIL (append-only, murojaat bilan birga
/// o'chadi), e'lon fayli esa BEZAK va u e'lon tahrirlanganda
/// almashtirilishi mumkin. Bitta jadvalga qo'shilsa, dalilni
/// o'chirish yo'li ochilardi.
model AnnouncementMedia {
  id String @id @default(cuid())

  announcementId String @map("announcement_id")

  kind IssueAttachmentKind

  /// ⚠️ DISKDAGI YO'L, BAZADAGI BAYTLAR EMAS (`uploads.service.ts`
  /// qoidasi). Nom — `randomUUID()`, asl nom yo'l sifatida
  /// ISHLATILMAYDI (`../../.env`).
  path         String
  mimeType     String  @map("mime_type")
  size         Int
  originalName String? @map("original_name")

  /// ⚠️ TARTIB QO'LDA: ilovada fayllar aynan shu ketma-ketlikda
  /// ko'rinadi va yuklash vaqti bo'yicha tartib tasodifiy bo'lardi.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId, sortOrder])
  @@map("announcement_media")
}

// ══════════════════════════════════════════════════════════════════════
//  TASHKILOTLAR — MUROJAATNI BAJARADIGAN TOMON
// ══════════════════════════════════════════════════════════════════════

/// IJROCHI TASHKILOT — suv ta'minoti, gaz, yo'l, hokimlik bo'limi.
///
/// ── NIMA UCHUN ALOHIDA JADVAL ─────────────────────────────────────
///
/// ⚠️ AVVAL TASHKILOT FAQAT MATN EDI (`IssueCategory.orgName`):
/// ilovada "Mas'ul tashkilot: Andijon suv ta'minoti" deb yozilardi,
/// lekin bu MANZIL emasdi. Murojaat unga bormasdi, xabar ketmasdi va
/// u panelga kira olmasdi — ya'ni "mas'ul" so'zi aholi uchun
/// ko'rinish, tashkilot uchun esa hech narsa edi.
///
/// ⚠️ `User` + `MahallaAssignee` BILAN AYNI SHAKL: bu jadval —
/// TOMON (kim), `OrganizationRoute` — QOIDA (qachon unga ketadi).
/// Ikkisini bitta jadvalga qo'shsak, bir yo'nalishni bir necha
/// tumanda bajaradigan tashkilot har tuman uchun QAYTA yozilardi va
/// uning telefoni, hisobi, Telegram manzili nusxalanardi.
///
/// ⚠️ O'CHIRILMAYDI, ARXIVLANADI: unga yo'naltirilgan murojaatlar
/// tarixi qoladi (`Issue.organizationId` — muhrlangan nusxa).
model Organization {
  id String @id @default(cuid())

  /// ⚠️ `@unique`: "Asaka suv ta'minoti" ikki marta kiritilsa,
  /// yo'naltirish qoidasi qaysi biriga tegishli ekani panelda
  /// ko'rinmay qolardi — ikki qator bir xil nom bilan turardi.
  name String @unique

  /// Panelda jadval ustuniga sig'adigan qisqa nom ("Suvoqova").
  shortName String? @map("short_name")

  /// ── TUMAN ───────────────────────────────────────────────────────
  ///
  /// ⚠️ `null` — VILOYAT DARAJASIDAGI tashkilot ("Andijon viloyat
  /// gaz ta'minoti"). Majburiy qilinsa, viloyat tashkilotini
  /// kiritish uchun tasodifiy tuman tanlash kerak bo'lardi va u
  /// hisobotda o'sha tumanning tashkiloti bo'lib ko'rinardi.
  districtId String? @map("district_id")

  /// Xodim qo'ng'iroq qilishi uchun (panelda ko'rinadi).
  phone   String?
  address String?

  /// ── XABARNOMA MANZILI ───────────────────────────────────────────
  ///
  /// ⚠️ TASHKILOTNING O'Z CHATI (ish guruhi yoki rahbarining
  /// shaxsiy chati). Bo'sh bo'lsa xabar uning FAOL xodimlarining
  /// `User.telegramId` lariga ketadi (`issue-notify.service.ts`) —
  /// ya'ni bitta manzil majburiy emas.
  ///
  /// ⚠️ MFY GURUHINING chat id'si QABUL QILINMAYDI (`TelegramGroup`
  /// reyestriga qarshi tekshiriladi). Aks holda bot KUZATILADIGAN
  /// guruhga yozib, "bot guruhda hech narsa yozmaydi" qoidasini
  /// buzardi — va o'sha xabar keyingi tahlilda SIGNALGA aylanib
  /// ketardi.
  ///
  /// ⚠️ `@unique`: bitta chat ikki tashkilotga qo'yilsa, u yerda
  /// begona murojaatlar paydo bo'lardi.
  telegramChatId String? @unique @map("telegram_chat_id")

  /// ── BOTGA ULANISH KODI ──────────────────────────────────────────
  ///
  /// ⚠️ CHAT ID'NI PANELDA QO'LDA YOZIB BO'LMAYDI: oddiy odam o'z
  /// chat id'sini bilmaydi va uni topish yo'li ham oson emas.
  /// Shuning uchun panel KOD beradi, tashkilot esa botga
  /// `/ulash <KOD>` deb yozadi — manzilni Telegram'ning O'ZI
  /// aytadi (`message.from.id`), ya'ni xato yozish imkoni yo'q.
  ///
  /// ⚠️ BIR MARTALIK: ishlatilgandan keyin `null` ga tushadi. Qolsa,
  /// kod tarqalgan holatda begona odam tashkilotning xabarnomalarini
  /// o'z chatiga burib yuborardi.
  linkCode String? @unique @map("link_code")

  isActive   Boolean   @default(true) @map("is_active")
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district District?           @relation(fields: [districtId], references: [id], onDelete: SetNull)
  routes   OrganizationRoute[]
  /// ⚠️ TASHKILOT XODIMLARI — `User`, `scopeKind: org`.
  users    User[]              @relation("OrgStaff")
  issues   Issue[]

  @@index([isArchived, name])
  @@index([districtId, isArchived])
  @@map("organizations")
}

/// YO'NALTIRISH QOIDASI — TUMAN × YO'NALISH → TASHKILOT.
///
/// ── NIMA UCHUN KALIT TUMAN, MFY EMAS ──────────────────────────────
///
/// ⚠️ `MahallaAssignee` MFY × YO'NALISH bo'yicha ishlaydi va u shtab
/// XODIMI uchun to'g'ri: bitta operator o'n MFY ni yuritadi. Tashkilot
/// esa tuman darajasida ishlaydi — "Asaka suv ta'minoti" o'sha
/// tumanning HAMMA mahallasiga xizmat qiladi. MFY bo'yicha kalit
/// qo'yilsa, 500 MFY × 22 yo'nalish = 11 000 qatorni QO'LDA to'ldirish
/// kerak bo'lardi va tizim o'sha ish bitmaguncha ishlamasdi.
///
/// ⚠️ `districtId: null` — VILOYAT ZAXIRASI: tumaniga aniq qoida
/// qo'yilmagan murojaat shu qoidaga tushadi. Ya'ni 22 ta viloyat
/// qatori butun viloyatni DARHOL ishga tushiradi, keyin tumanlar
/// birma-bir aniqlashtiriladi.
///
/// ⚠️ `@@unique([categoryId, districtId])` — bitta (yo'nalish, tuman)
/// juftligiga BITTA tashkilot (`MahallaAssignee` dagi ayni sabab):
/// ikkitasi bo'lsa "qaysi biri" degan savol har murojaatda TASODIFIY
/// hal bo'lardi.
///
/// ⚠️ LEKIN BU CHEKLOV VILOYAT ZAXIRASINI (`districtId: null`)
/// HIMOYA QILMAYDI: PostgreSQL `UNIQUE` da `NULL` larni BIR-BIRIGA
/// TENG DEB HISOBLAMAYDI, ya'ni ayni yo'nalish uchun ikkita viloyat
/// qatori bazaga jim o'tib ketardi. Qisman indeks (`WHERE
/// district_id IS NULL`) Prisma sxemasida ifodalanmaydi va qo'lda
/// yozilsa keyingi `migrate dev` uni O'CHIRIB tashlardi — ya'ni
/// himoya bir kuni jimgina yo'qolardi.
///
/// Shuning uchun tekshiruv XIZMATDA (`organizations.service.ts#
/// saveRoute`), va qidiruv TARTIBI aniq (`resolve` da `createdAt`
/// bo'yicha): tasodifan ikkita qator paydo bo'lsa ham, qaysi biri
/// ishlayotgani tushuntirib beriladigan bo'lib qoladi.
///
/// ⚠️ HAQIQIY O'CHIRISH, `isActive: false` EMAS: qoida — SOZLAMA,
/// dalil emas. "Kim qachon qo'ygan" javobi `AuditLog` da qoladi.
model OrganizationRoute {
  id String @id @default(cuid())

  organizationId String @map("organization_id")
  categoryId     String @map("category_id")

  /// `null` — viloyat bo'ylab zaxira (yuqoridagi izoh).
  districtId String? @map("district_id")

  isActive Boolean @default(true) @map("is_active")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     IssueCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  district     District?     @relation(fields: [districtId], references: [id], onDelete: Cascade)
  author       User?         @relation("OrgRouteAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([categoryId, districtId])
  @@index([organizationId])
  @@index([districtId])
  @@map("organization_routes")
}
